@@ -0,0 +1,27 @@
+import { Effect, Layer } from "effect"
+import { JobEnqueue } from "effect-jobs/JobEnqueue"
+import { PostgreSqlJobs } from "effect-jobs/PostgreSqlJobs"
+import * as Authority from "../persistence/authority/PostgreSqlAuthority.js"
+import * as Commands from "../persistence/commands/Persistence.js"
+import * as Executor from "./Executor.js"
+
+/** Inert composition for the shared registrar. The application supplies one qualified
+ * scoped PgClient/SqlClient and backend plus stable synthetic DocumentKeys.
+ * Never acquire fresh encryption keys per event: retained jobs require the original keys.
+ * This Layer neither starts a worker nor registers/runs migrations.
+ */
+export const layerNoDeps = (schema: string) =>
+  Layer.unwrap(
+    Effect.gen(function* () {
+      const backend = yield* PostgreSqlJobs
+      const commands = Commands.layerNoDeps.pipe(
+        Layer.provide(Authority.transactionsLayerNoDeps(schema)),
+        Layer.provide(Layer.succeed(JobEnqueue, backend.producer))
+      )
+      return Layer.mergeAll(
+        Authority.authorityLayerNoDeps(schema),
+        commands,
+        Executor.workerLayerNoDeps(schema)
+      )
+    })
+  )
diff --git a/apps/playground-worker/src/execution/Executor.ts b/apps/playground-worker/src/execution/Executor.ts
new file mode 100644
index 0000000..6cfaf90
--- /dev/null
+++ b/apps/playground-worker/src/execution/Executor.ts
@@ -0,0 +1,205 @@
+// @effect-diagnostics unstableApiUsage:off
+import { Clock, Context, Effect, Layer, Schema } from "effect"
+import { SqlClient } from "effect/sql/SqlClient"
+import * as Consumer from "effect-jobs/JobConsumer"
+import * as Runtime from "effect-jobs/JobWorkerRuntime"
+import * as Worker from "effect-jobs/JobWorker"
+import * as Registry from "effect-jobs/JobRegistry"
+import { PostgreSqlJobs } from "effect-jobs/PostgreSqlJobs"
+import { CommandPersistence } from "../persistence/commands/Transactions.js"
+import { SandboxView } from "@effect-jobs/playground-contracts/Sandbox"
+import * as Definitions from "../scenarios/Definitions.js"
+import * as Handlers from "../scenarios/Handlers.js"
+import * as Provider from "./PostgreSqlProvider.js"
+import * as Tables from "../persistence/authority/Schema.js"
+import { WakeAlarm } from "../cloudflare/WakeCycle.js"
+
+export const limits = Object.freeze({
+  cycleMillis: 5000,
+  generationMillis: 5000,
+  repairMillis: 5000,
+  claimLimit: 10,
+  recoveryLimit: 10,
+  concurrency: 2
+})
+// Four fixed application queue identities, independent of sandbox/job cardinality.
+export const queueNames = [
+  "playground-communications",
+  "playground-media",
+  "playground-commerce",
+  "playground-private"
+] as const
+export type QueueName = (typeof queueNames)[number]
+export class ExecutionHints extends Context.Service<
+  ExecutionHints,
+  {
+    // Internal invalidation only; adapter reconciles authoritative scoped reads.
+    readonly reconcile: Effect.Effect<void>
+  }
+>()("playground/ExecutionHints") {}
+export class ExecutionDeadline extends Schema.TaggedError<ExecutionDeadline>()(
+  "ExecutionDeadline",
+  {}
+) {}
+
+export const consumers = Effect.forEach(queueNames, (name) =>
+  Consumer.make(
+    Definitions.definitions.find((definition) => definition.queue.name === name)!.queue,
+    {
+      localConcurrency: limits.concurrency,
+      claimLimitPerRun: limits.claimLimit,
+      recoveryLimitPerRun: limits.recoveryLimit
+    }
+  )
+)
+export const workerLayerNoDeps = (schema: string) =>
+  Layer.unwrap(
+    Effect.gen(function* () {
+      const backend = yield* PostgreSqlJobs
+      return Worker.layer(backend.store, {
+        catalog: Definitions.definitions,
+        operationResponseBudgetMillis: 500
+      }).pipe(
+        Layer.provide(Handlers.layerNoDeps),
+        Layer.provide(Registry.layer),
+        Layer.provide(Provider.layerNoDeps(schema))
+      )
+    })
+  )
+
+export const snapshot = (schema: string, queue: QueueName) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient
+    const t = Tables.relations(schema)
+    const [row] = yield* sql.unsafe<{
+      now: string
+      active_until: string | null
+      due: string | null
+      recovery: string | null
+      generate: string | null
+    }>(
+      `WITH t AS MATERIALIZED (SELECT floor(extract(epoch FROM clock_timestamp())*1000)::bigint AS now)
+    SELECT t.now,
+      (SELECT max(LEAST(expires_at,viewer_until)) FROM ${t.sandboxes} WHERE expires_at>t.now AND viewer_until>t.now) AS active_until,
+      (SELECT min(j.available_at) FROM ${t.jobs} j JOIN ${t.associations} a ON a.job_id=j.id JOIN ${t.sandboxes} s ON s.sandbox_id=a.sandbox_id
+        WHERE j.queue=$1 AND j.state IN ('Pending','RetryScheduled') AND a.generation=s.generation AND s.expires_at>t.now AND s.viewer_until>t.now) AS due,
+      (SELECT min(lease_expires_at) FROM ${t.jobs} WHERE queue=$1 AND state='Active') AS recovery,
+      (SELECT min(next_generation_at) FROM ${t.sandboxes} WHERE expires_at>t.now AND viewer_until>t.now AND retained_jobs<100) AS generate FROM t`,
+      [queue]
+    )
+    const now = Number(row!.now)
+    return {
+      activeMillis:
+        row!.active_until === null ? 0 : Math.max(0, Number(row!.active_until) - now),
+      nextMillis: Math.max(
+        0,
+        Math.min(
+          limits.repairMillis,
+          ...[row!.due, row!.recovery, row!.generate]
+            .filter((n) => n !== null)
+            .map((n) => Number(n) - now)
+        )
+      )
+    }
+  })
+
+// One deterministic generator request per event, capped by retained quota and DB-time viewer authority.
+// Only the communications DO generates; all DOs drain their own fixed queue.
+export const generate = (schema: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient
+    const persistence = yield* CommandPersistence
+    const t = Tables.relations(schema)
+    const rows = yield* sql.unsafe<
+      Record<string, unknown>
+    >(`SELECT *,floor(extract(epoch FROM clock_timestamp())*1000)::bigint AS now FROM ${t.sandboxes}
+    WHERE expires_at>floor(extract(epoch FROM clock_timestamp())*1000)::bigint
+      AND viewer_until>floor(extract(epoch FROM clock_timestamp())*1000)::bigint
+      AND next_generation_at<=floor(extract(epoch FROM clock_timestamp())*1000)::bigint AND retained_jobs<100 ORDER BY sandbox_id LIMIT 1`)
+    if (!rows[0]) {
+      return
+    }
+    const row = rows[0]
+    const sandbox = yield* Schema.decodeUnknownEffect(SandboxView)({
+      ref: { sandboxId: row.sandbox_id, generation: Number(row.generation) },
+      expiresAt: Number(row.expires_at),
+      capabilities: {
+        runScenario: true,
+        resetSandbox: true,
+        retryJob: false,
+        redriveJob: false,
+        cancelJob: false
+      }
+    })
+    const result = yield* persistence.run(
+      { sandbox },
+      {
+        sandbox: sandbox.ref,
+        requestId: `auto-${String(row.next_generation_at)}`,
+        scenario: "success",
+        count: 1
+      }
+    )
+    // Advance even Unknown: read-only exact receipt is available; never authorize write replay.
+    yield* sql.unsafe(
+      `UPDATE ${t.sandboxes} SET next_generation_at=GREATEST(next_generation_at+5000,$3::bigint+5000)
+    WHERE sandbox_id=$1 AND generation=$2 AND next_generation_at=$4 AND viewer_until>$3::bigint AND expires_at>$3::bigint`,
+      [sandbox.ref.sandboxId, sandbox.ref.generation, row.now, row.next_generation_at]
+    )
+    return result
+  })
+
+// Caller serializes native DO events and owns one event Scope/PgClient lifetime.
+// Alarm prearm is a repair hint; failure/interrupt never implies rollback or cancellation.
+export const run = (schema: string, queue: QueueName) =>
+  Effect.gen(function* () {
+    const alarm = yield* WakeAlarm
+    const hints = yield* ExecutionHints
+    const before = yield* snapshot(schema, queue)
+    if (before.activeMillis === 0) {
+      yield* alarm.clear
+      return { _tag: "Retired" as const }
+    }
+    const now = yield* Clock.currentTimeMillis
+    yield* alarm.set(now + Math.min(before.activeMillis, limits.repairMillis))
+    if (queue === "playground-communications") {
+      yield* generate(schema).pipe(
+        Effect.catchTag("PlaygroundError", (error) =>
+          ["sandbox-expired", "stale-generation", "limit-reached"].includes(error.code)
+            ? Effect.void
+            : Effect.fail(error)
+        )
+      )
+    }
+    const plans = yield* consumers
+    const consumer = plans.find((plan) => plan.queue.name === queue)!
+    const result = yield* Runtime.drain(consumer)
+    yield* hints.reconcile
+    const after = yield* snapshot(schema, queue)
+    if (after.activeMillis === 0) {
+      yield* alarm.clear
+      return { _tag: "Retired" as const }
+    }
+    const at = yield* Clock.currentTimeMillis
+    yield* alarm.set(
+      at +
+        Math.max(
+          100,
+          Math.min(
+            after.activeMillis,
+            result._tag === "MoreWork"
+              ? 100
+              : result._tag === "Backoff"
+                ? 1000
+                : after.nextMillis,
+            limits.repairMillis
+          )
+        )
+    )
+    return result
+  }).pipe(
+    Effect.timeoutOrElse({
+      duration: limits.cycleMillis,
+      orElse: () => Effect.fail(new ExecutionDeadline())
+    })
+  )
diff --git a/apps/playground-worker/src/execution/PostgreSqlProvider.ts b/apps/playground-worker/src/execution/PostgreSqlProvider.ts
new file mode 100644
index 0000000..65f1055
--- /dev/null
+++ b/apps/playground-worker/src/execution/PostgreSqlProvider.ts
@@ -0,0 +1,142 @@
+// Durable synthetic provider only: no network/payment/email and no lifecycle SQL.
+// @effect-diagnostics unstableApiUsage:off
+import { Cause, Effect, Layer } from "effect"
+import { SqlClient } from "effect/sql/SqlClient"
+import {
+  FakeProvider,
+  InvariantViolation,
+  PayloadConflict,
+  ResponseLost,
+  RetryRejected,
+  TerminalRejected,
+  LedgerFull
+} from "../providers/FakeProvider.js"
+import type { ProviderCommand, ProviderFailure } from "../providers/FakeProvider.js"
+import * as Tables from "../persistence/authority/Schema.js"
+
+export const make = (schema: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient
+    const t = Tables.relations(schema)
+    return FakeProvider.of({
+      execute: (command: ProviderCommand) =>
+        Effect.gen(function* () {
+          // Copy before the first async boundary; only the hash persists, never payload bytes.
+          const projection = new Uint8Array(command.semanticProjection)
+          const signature = yield* Effect.tryPromise({
+            try: async () =>
+              JSON.stringify([
+                command.workload,
+                command.behavior,
+                Array.from(
+                  new Uint8Array(await crypto.subtle.digest("SHA-256", projection))
+                )
+              ]),
+            catch: () => new InvariantViolation()
+          })
+          const outcome = yield* sql
+            .withTransaction(
+              Effect.gen(function* () {
+                const rows = yield* sql.unsafe<Record<string, unknown>>(
+                  `SELECT *
+          FROM ${t.sandboxes} WHERE sandbox_id=$1 FOR UPDATE`,
+                  [command.sandbox.sandboxId]
+                )
+                const sandbox = rows[0]
+                const [clock] = yield* sql.unsafe<{ now: string }>(
+                  "SELECT floor(extract(epoch FROM clock_timestamp())*1000)::bigint AS now"
+                )
+                if (
+                  !sandbox ||
+                  Number(sandbox.generation) !== command.sandbox.generation ||
+                  Number(sandbox.expires_at) <= Number(clock!.now)
+                ) {
+                  return new InvariantViolation()
+                }
+                // A decoded payload is insufficient authority: bind producer to its actual mapped job.
+                const jobs = yield* sql.unsafe<Record<string, unknown>>(
+                  `SELECT j.id FROM ${t.jobs} j JOIN ${t.associations} a ON a.job_id=j.id
+          WHERE a.sandbox_id=$1 AND a.generation=$2 AND j.operation=$3 AND j.operation_id=$4 AND j.slot=$5 AND j.kind=$6`,
+                  [
+                    command.sandbox.sandboxId,
+                    command.sandbox.generation,
+                    command.producer.operation,
+                    command.producer.operationId,
+                    command.producer.slot,
+                    `playground.${command.workload}`
+                  ]
+                )
+                const job = jobs[0]
+                if (!job) {
+                  return new InvariantViolation()
+                }
+                const existing = (yield* sql.unsafe<Record<string, unknown>>(
+                  `SELECT * FROM ${t.ledger} WHERE job_id=$1`,
+                  [job.id]
+                ))[0]
+                if (existing && existing.signature !== signature) {
+                  return new PayloadConflict()
+                }
+                if (!existing) {
+                  const size = (yield* sql.unsafe<{ n: number }>(
+                    `SELECT count(*)::int AS n FROM ${t.ledger} WHERE sandbox_id=$1`,
+                    [command.sandbox.sandboxId]
+                  ))[0]!.n
+                  if (size >= 100) {
+                    return new LedgerFull()
+                  }
+                }
+                const invocations = Math.min(
+                  Number(existing?.invocations ?? 0) + 1,
+                  1_000_000
+                )
+                const alreadyAccepted = existing?.accepted === true
+                const accepted =
+                  alreadyAccepted ||
+                  (command.behavior !== "dead" &&
+                    command.behavior !== "isolated" &&
+                    !(command.behavior === "retry-then-success" && invocations === 1))
+                yield* sql.unsafe(
+                  `INSERT INTO ${t.ledger} VALUES ($1,$2,$3,$4,$5,$6)
+          ON CONFLICT (sandbox_id,generation,job_id) DO UPDATE SET accepted=EXCLUDED.accepted,invocations=EXCLUDED.invocations`,
+                  [
+                    command.sandbox.sandboxId,
+                    command.sandbox.generation,
+                    job.id,
+                    signature,
+                    accepted,
+                    invocations
+                  ]
+                )
+                if (alreadyAccepted) {
+                  return undefined
+                }
+                switch (command.behavior) {
+                  case "success":
+                    return undefined
+                  case "retry-then-success":
+                    return invocations === 1 ? new RetryRejected() : undefined
+                  case "dead":
+                    return new TerminalRejected()
+                  case "isolated":
+                    return new InvariantViolation()
+                  case "accepted-response-lost":
+                    return new ResponseLost()
+                }
+              })
+            )
+            .pipe(
+              Effect.catchCause((cause) =>
+                Effect.failCause(Cause.map(cause, () => new ResponseLost()))
+              )
+            )
+          // Expected synthetic failure is returned AFTER acknowledged ledger commit.
+          if (outcome) {
+            return yield* Effect.fail(outcome as ProviderFailure)
+          }
+        }),
+      // Mock observation DTO has source="mock"; a durable ledger must not impersonate it.
+      inspect: () => Effect.succeed(undefined)
+    })
+  })
+export const layerNoDeps = (schema: string) => Layer.effect(FakeProvider, make(schema))
diff --git a/apps/playground-worker/src/execution/README.md b/apps/playground-worker/src/execution/README.md
