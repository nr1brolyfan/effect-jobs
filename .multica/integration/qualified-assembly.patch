+    createHash("sha256")
+      .update(readFileSync(join(directory, file)))
+      .digest("hex")
+  ])
+)
+console.log(
+  JSON.stringify(
+    {
+      sdk: manifest.version,
+      callbackExport: "PASS",
+      snapshots,
+      deployment: "NotTested",
+      alarmOwnership:
