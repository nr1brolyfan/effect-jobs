new file mode 100644
index 0000000..c73006b
--- /dev/null
+++ b/apps/playground-worker/src/scenarios/Plan.ts
@@ -0,0 +1,129 @@
+import { Data, Effect, Schema } from "effect"
+import { ScenarioCommand } from "@effect-jobs/playground-contracts/Scenarios"
+import type { SandboxRef } from "@effect-jobs/playground-contracts/Sandbox"
+import * as JobPolicy from "effect-jobs/JobPolicy"
+import * as Definitions from "./Definitions.js"
+
+export class InvalidScenario extends Data.TaggedError("InvalidScenario")<{}> {}
+export interface PlannedJob {
+  readonly workload: Definitions.Workload
+  readonly payload: Definitions.Payload
+  readonly producer: ReturnType<typeof Definitions.Producer.identity>
+  readonly policy: JobPolicy.JobPolicy
+  readonly availableAt?: number
+}
+
+const workloads = Definitions.Workload.literals
+const behavior = (scenario: ScenarioCommand["scenario"]): Definitions.Behavior => {
+  switch (scenario) {
+    case "success":
+    case "deduplication":
+      return "success"
+    case "retry-then-success":
+      return "retry-then-success"
+    case "terminal-failure":
+      return "dead"
+    case "unknown-outcome":
+      return "accepted-response-lost"
+  }
+}
+
+/** Pure app planning plus a stable hashed producer namespace; no DB writes.
+ * The caller supplies authenticated authority and a fixed server-owned seed.
+ * Admission/expiry, quotas, receipts and atomic enqueue are the command adapter's job.
+ */
+export const plan = Effect.fn("Playground.plan")(function* (
+  input: unknown,
+  authorized: SandboxRef,
+  seed: number,
+  availableAt?: number
+) {
+  const command = yield* Schema.decodeUnknownEffect(ScenarioCommand)(input, {
+    onExcessProperty: "error"
+  }).pipe(Effect.mapError(() => new InvalidScenario()))
+  if (
+    command.sandbox.sandboxId !== authorized.sandboxId ||
+    command.sandbox.generation !== authorized.generation ||
+    !Schema.is(Definitions.Payload.fields.seed)(seed) ||
+    (availableAt !== undefined && !Schema.is(JobPolicy.EpochMillis)(availableAt))
+  ) {
+    return yield* new InvalidScenario()
+  }
+  const bytes = new TextEncoder().encode(
+    JSON.stringify([authorized.sandboxId, authorized.generation, command.requestId])
+  )
+  const digest = yield* Effect.tryPromise({
+    try: () => crypto.subtle.digest("SHA-256", bytes),
+    catch: () => new InvalidScenario()
+  })
+  const operationId = `sandbox-request-${Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, "0")).join("")}`
+  const jobs: PlannedJob[] = []
+  for (let index = 0; index < command.count; index++) {
+    const workload = workloads[(seed + index) % workloads.length]!
+    jobs.push({
+      workload,
+      payload: {
+        sandbox: { ...authorized },
+        version: 1,
+        seed,
+        sequence: index + 1,
+        behavior: behavior(command.scenario),
+        actor: "demo-customer",
+        tenant: (seed + index) % 2 === 0 ? "demo-tenant-a" : "demo-tenant-b",
+        order: (seed + index) % 2 === 0 ? "demo-order-a" : "demo-order-b"
+      },
+      producer: Definitions.Producer.identity({ operationId, slot: workload }),
+      policy: JobPolicy.make(),
+      ...(availableAt === undefined ? {} : { availableAt })
+    })
+  }
+  // A slot can appear more than once in a 10-job batch. Distinguish consequences
+  // by sequence while retaining the operation/request namespace on replay.
+  return jobs.map((job) => ({
+    ...job,
+    producer: Definitions.Producer.identity({
+      operationId: `${operationId}-${job.payload.sequence}`,
+      slot: job.workload
+    })
+  }))
+})
+
+export const exportPayload = (
+  payload: Definitions.Payload
+): Definitions.ExportPayload => ({
+  ...payload,
+  document: {
+    subject: payload.actor,
+    tenant: payload.tenant,
+    note: "synthetic private export v1"
+  }
+})
+
+/** Enqueue joins the configured application transaction. Results remain provisional.
+ * Do not run concurrently inside one transaction or convert a conflict into success.
+ */
+export const enqueue = (job: PlannedJob) => {
+  const input = {
+    producer: job.producer,
+    policy: job.policy,
+    payload: job.payload,
+    ...(job.availableAt === undefined ? {} : { availableAt: job.availableAt })
+  }
+  switch (job.workload) {
+    case "welcome-email":
+      return Definitions.WelcomeEmail.enqueue(input)
+    case "image-processing":
+      return Definitions.ImageProcessing.enqueue(input)
+    case "webhook-delivery":
+      return Definitions.WebhookDelivery.enqueue(input)
+    case "private-data-export":
+      return Definitions.PrivateDataExport.enqueue({
+        ...input,
+        payload: exportPayload(job.payload)
+      })
+    case "catalog-sync":
+      return Definitions.CatalogSync.enqueue(input)
+    case "simulated-payment":
+      return Definitions.SimulatedPayment.enqueue(input)
+  }
+}
diff --git a/apps/playground-worker/src/scenarios/PrivateDocument.ts b/apps/playground-worker/src/scenarios/PrivateDocument.ts
new file mode 100644
index 0000000..ddc7e69
--- /dev/null
+++ b/apps/playground-worker/src/scenarios/PrivateDocument.ts
@@ -0,0 +1,101 @@
+import { Context, Effect, Layer, Schema } from "effect"
+import * as JobPayload from "effect-jobs/JobPayload"
+
+// Web Crypto is the application FFI. Keys are ephemeral and synthetic; no env access.
+export class DocumentKeys extends Context.Service<
+  DocumentKeys,
+  { readonly encryption: CryptoKey; readonly fingerprint: CryptoKey }
+>()("playground/DocumentKeys") {}
+
+export const Document = Schema.Struct({
+  subject: Schema.Literal("demo-customer"),
+  tenant: Schema.Literals(["demo-tenant-a", "demo-tenant-b"]),
+  note: Schema.String.pipe(Schema.check(Schema.isMaxLength(256)))
+})
+const Envelope = Schema.Struct({
+  nonce: Schema.Array(
+    Schema.Int.pipe(Schema.check(Schema.isBetween({ minimum: 0, maximum: 255 })))
+  ).pipe(Schema.check(Schema.isMinLength(12), Schema.isMaxLength(12))),
+  ciphertext: Schema.Array(
+    Schema.Int.pipe(Schema.check(Schema.isBetween({ minimum: 0, maximum: 255 })))
+  ).pipe(Schema.check(Schema.isMaxLength(2048))),
+  fingerprint: Schema.String.pipe(
+    Schema.check(Schema.isMinLength(64), Schema.isMaxLength(64))
+  )
+})
+const aad = new TextEncoder().encode("playground-private-document-v1")
+const canonical = (value: typeof Document.Encoded) =>
+  new TextEncoder().encode(
+    JSON.stringify({ subject: value.subject, tenant: value.tenant, note: value.note })
+  )
+const hex = (value: ArrayBuffer) =>
+  Array.from(new Uint8Array(value), (byte) => byte.toString(16).padStart(2, "0")).join("")
+const cryptoOperation = <A>(run: () => Promise<A>) =>
+  Effect.tryPromise({ try: run, catch: () => new JobPayload.JobEncryptionError() })
+
+export const keysLayer = Layer.effect(
+  DocumentKeys,
+  cryptoOperation(async () => ({
+    encryption: await crypto.subtle.generateKey({ name: "AES-GCM", length: 256 }, false, [
+      "encrypt",
+      "decrypt"
+    ]),
+    fingerprint: await crypto.subtle.generateKey(
+      { name: "HMAC", hash: "SHA-256", length: 256 },
+      false,
+      ["sign", "verify"]
+    )
+  }))
+)
+
+const codec: JobPayload.EncryptionCodec<
+  typeof Document.Encoded,
+  typeof Envelope,
+  DocumentKeys,
+  DocumentKeys
+> = {
+  envelope: Envelope,
+  seal: (value) =>
+    Effect.gen(function* () {
+      const keys = yield* DocumentKeys
+      return yield* cryptoOperation(async () => {
+        const bytes = canonical(value)
+        const nonce = crypto.getRandomValues(new Uint8Array(12))
+        const ciphertext = await crypto.subtle.encrypt(
+          { name: "AES-GCM", iv: nonce, additionalData: aad },
+          keys.encryption,
+          bytes
+        )
+        const fingerprint = hex(await crypto.subtle.sign("HMAC", keys.fingerprint, bytes))
+        return {
+          nonce: Array.from(nonce),
+          ciphertext: Array.from(new Uint8Array(ciphertext)),
+          fingerprint
+        }
+      })
+    }),
+  open: (envelope) =>
+    Effect.gen(function* () {
+      const keys = yield* DocumentKeys
+      return yield* cryptoOperation(async () => {
+        const plaintext = await crypto.subtle.decrypt(
+          { name: "AES-GCM", iv: new Uint8Array(envelope.nonce), additionalData: aad },
+          keys.encryption,
+          new Uint8Array(envelope.ciphertext)
+        )
+        const value = Schema.decodeUnknownSync(Document)(
+          JSON.parse(new TextDecoder("utf-8", { fatal: true }).decode(plaintext)),
+          { onExcessProperty: "error" }
+        )
+        const expected = hex(
+          await crypto.subtle.sign("HMAC", keys.fingerprint, canonical(value))
+        )
+        if (expected !== envelope.fingerprint) {
+          throw new JobPayload.JobEncryptionError()
+        }
+        return value
+      })
+    })
+}
+
+export const EncryptedDocument = JobPayload.encrypted({ schema: Document, codec })
