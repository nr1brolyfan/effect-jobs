@@ -0,0 +1,39 @@
+import assert from "node:assert/strict"
+import { readFileSync } from "node:fs"
+import { Miniflare, convertV4MiniflareOptions } from "miniflare"
+
+const mf = new Miniflare(
+  convertV4MiniflareOptions({
+    modules: true,
+    script: readFileSync("Worker.js", "utf8"),
+    compatibilityDate: "2026-10-01",
+    compatibilityFlags: ["nodejs_compat"],
+    durableObjects: { PROBE: { className: "Probe", useSQLite: true } },
+    durableObjectsPersist: false,
+    // Reject all outgoing HTTP calls. The probe performs no PostgreSQL queries.
+    outboundService: () => new Response("Outbound denied", { status: 403 })
+  })
+)
+try {
+  const native = await (await mf.dispatchFetch("https://probe.invalid/native")).json()
+  assert.deepEqual(native, {
+    noActive: "transaction-required",
+    commitKnowledge: "NotCommitted"
+  })
+  const wake = await (await mf.dispatchFetch("https://probe.invalid/wake")).json()
+  assert.deepEqual(wake, {
+    result: { _tag: "Idle", claimed: 0, recovered: 0 },
+    alarmSet: true
+  })
+  console.log(
+    JSON.stringify({
+      runtime: "local-workerd",
+      native,
+      wake,
+      postgres: "NotTested",
+      hosted: "NotTested"
+    })
+  )
+} finally {
+  await mf.dispose()
+}
diff --git a/apps/playground-worker/tests/cloudflare/WorkerdProbe.mts.txt b/apps/playground-worker/tests/cloudflare/WorkerdProbe.mts.txt
new file mode 100644
index 0000000..fe11b8a
--- /dev/null
+++ b/apps/playground-worker/tests/cloudflare/WorkerdProbe.mts.txt
@@ -0,0 +1,135 @@
+// @effect-diagnostics unstableApiUsage:off
+// Qualification-only native Cloudflare FFI. No public route or deployment registrar.
+import { DurableObject } from "cloudflare:workers"
+import type {
+  DurableObjectNamespace,
+  Request as WorkerRequest
+} from "@cloudflare/workers-types"
+import { Effect, Layer, Redacted, Schema } from "effect"
+import * as Reactivity from "effect/reactivity/Reactivity"
+import * as PgClient from "@effect/sql-pg/PgClient"
+import * as Native from "effect-jobs/PostgreSqlNative"
+import * as Backend from "effect-jobs/PostgreSqlJobs"
+import { PostgreSqlApplication } from "effect-jobs/PostgreSqlTransaction"
+import { JobEnqueue } from "effect-jobs/JobEnqueue"
+import * as Job from "effect-jobs/Job"
+import * as Codec from "effect-jobs/JobPayloadCodec"
+import * as Queue from "effect-jobs/JobQueue"
+import * as Policy from "effect-jobs/JobPolicy"
+import * as Producer from "effect-jobs/JobProducer"
+import * as Consumer from "effect-jobs/JobConsumer"
+import * as Registry from "effect-jobs/JobRegistry"
+import * as Worker from "effect-jobs/JobWorker"
+import type { JobStoreService } from "effect-jobs/JobStore"
+import * as WakeCycle from "../../src/cloudflare/WakeCycle.js"
+
+// Workerd supplies this global; use its official type instead of Node fetch types.
+declare const Response: typeof import("@cloudflare/workers-types").Response
+
+const queue = Queue.make("cloudflare-probe")
+const producer = Producer.make({ operation: "cloudflare.probe", slots: ["synthetic"] })
+const definition = Job.make({
+  queue,
+  kind: "synthetic",
+  payload: Schema.String,
+  encodePayload: Codec.encodeJobPayload
+})
+
+const nativeProbe = Effect.scoped(
+  Effect.gen(function* () {
+    // Zero eager connections and no SQL: this synthetic URL is never connected.
+    const client = yield* PgClient.make({
+      url: Redacted.make("postgres://synthetic:synthetic@127.0.0.1:1/synthetic"),
+      minConnections: 0,
+      maxConnections: 2,
+      prepare: false,
+      connectTimeout: "1 second",
+      idleTimeout: "1 second"
+    })
+    const adapter = Native.make({ client, operationTimeoutMillis: 1_000 })
+    const backend = yield* Backend.make({ operationResponseBudgetMillis: 100 }).pipe(
+      Effect.provideService(PostgreSqlApplication, adapter)
+    )
+    const result = yield* definition
+      .enqueue({
+        producer: producer.identity({ operationId: "synthetic-1", slot: "synthetic" }),
+        payload: "synthetic",
+        policy: Policy.make()
+      })
+      .pipe(Effect.provideService(JobEnqueue, backend.producer), Effect.result)
+    return result._tag === "Failure" && result.failure._tag === "JobBackendError"
+      ? {
+          noActive: result.failure.reason,
+          commitKnowledge: result.failure.commitKnowledge
+        }
+      : { noActive: "unexpected" }
+  })
+).pipe(Effect.provide(Reactivity.layer), Effect.timeout("3 seconds"))
+
+export class Probe extends DurableObject {
+  async fetch(request: WorkerRequest) {
+    return this.ctx.blockConcurrencyWhile(async () => {
+      if (new URL(request.url).pathname === "/native") {
+        return Response.json(await Effect.runPromise(nativeProbe))
+      }
+      const unexpected = () => Effect.die("Unexpected mock operation")
+      const store: JobStoreService = {
+        claim: () => Effect.succeed({ _tag: "Empty" }),
+        recoverExpired: () => Effect.succeed(0),
+        reconcileClaim: unexpected,
+        release: unexpected,
+        finalize: unexpected,
+        reconcileFinalization: unexpected
+      }
+      const worker = Worker.layer(store, {
+        catalog: [definition],
+        operationResponseBudgetMillis: 100
+      }).pipe(
+        Layer.provide(definition.handlerLayer(() => Effect.void, Codec.decodeJobPayload)),
+        Layer.provide(Registry.layer)
+      )
+      const result = await Effect.runPromise(
+        Consumer.make(queue, {
+          localConcurrency: 2,
+          claimLimitPerRun: 10,
+          recoveryLimitPerRun: 10
+        }).pipe(
+          Effect.flatMap(WakeCycle.run),
+          Effect.provide(worker),
+          Effect.provideService(WakeCycle.WakeSchedule, {
+            read: Effect.succeed({
+              expiresInMillis: 60_000,
+              dueInMillis: 10_000,
+              recoveryInMillis: null
+            })
+          }),
+          Effect.provideService(WakeCycle.WakeAlarm, {
+            set: (at) =>
+              Effect.tryPromise({
+                try: () => this.ctx.storage.setAlarm(at),
+                catch: () => new WakeCycle.WakeUnavailable()
+              }),
+            clear: Effect.tryPromise({
+              try: () => this.ctx.storage.deleteAlarm(),
+              catch: () => new WakeCycle.WakeUnavailable()
+            })
+          })
+        )
+      )
+      const alarm = await this.ctx.storage.getAlarm()
+      await this.ctx.storage.deleteAlarm()
+      return Response.json({ result, alarmSet: alarm !== null })
+    })
+  }
+
+  // This isolated harness deletes alarms after inspection; no real PG handler is wired.
+  async alarm() {
+    await this.ctx.storage.deleteAlarm()
+  }
+}
+
+export default {
+  fetch(request: WorkerRequest, env: { PROBE: DurableObjectNamespace }) {
+    return env.PROBE.get(env.PROBE.idFromName("synthetic")).fetch(request)
+  }
+}
diff --git a/apps/playground-worker/tests/execution/AffectedProbe.mjs b/apps/playground-worker/tests/execution/AffectedProbe.mjs
new file mode 100644
index 0000000..3a141f3
--- /dev/null
+++ b/apps/playground-worker/tests/execution/AffectedProbe.mjs
@@ -0,0 +1,265 @@
+// Affected original PG assertions only: provider outcomes/ledger and executor wakes.
+// Reset, quota, authority and interruption receipts are reused for unchanged inputs.
+import assert from "node:assert/strict"
+import { Duration, Effect, Exit, Layer, Redacted } from "effect"
+import * as Reactivity from "effect/reactivity/Reactivity"
+import * as Pg from "@effect/sql-pg/PgClient"
+import { SqlClient } from "effect/sql/SqlClient"
+import * as Native from "effect-jobs/PostgreSqlNative"
+import * as Backend from "effect-jobs/PostgreSqlJobs"
+import { PostgreSqlApplication } from "effect-jobs/PostgreSqlTransaction"
+import { JobEnqueue } from "effect-jobs/JobEnqueue"
+import * as Policy from "effect-jobs/JobPolicy"
+import * as Codec from "effect-jobs/JobPayloadCodec"
+import * as Authority from "./dist/src/persistence/authority/PostgreSqlAuthority.js"
+import * as Persistence from "./dist/src/persistence/commands/Persistence.js"
+import {
+  CommandPersistence,
+  CommandTransactions
+} from "./dist/src/persistence/commands/Transactions.js"
+import * as Provider from "./dist/src/execution/PostgreSqlProvider.js"
+import * as Executor from "./dist/src/execution/Executor.js"
+import * as Application from "./dist/src/execution/Application.js"
+import * as Definitions from "./dist/src/scenarios/Definitions.js"
+import * as Plan from "./dist/src/scenarios/Plan.js"
+import * as Documents from "./dist/src/scenarios/PrivateDocument.js"
+import { WakeAlarm } from "./dist/src/cloudflare/WakeCycle.js"
+
+export const probe = (url, schema, alarm, checks = []) =>
+  Effect.scoped(
+    Effect.gen(function* () {
+      const client = yield* Pg.make({
+        url: Redacted.make(url),
+        minConnections: 0,
+        maxConnections: 6,
+        prepare: false,
+        connectTimeout: "2 seconds",
+        idleTimeout: "1 second"
+      })
+      const adapter = Native.make({ client, operationTimeoutMillis: 2000 })
+      const backend = yield* Backend.make({
+        schema,
+        operationResponseBudgetMillis: 500
+      }).pipe(Effect.provideService(PostgreSqlApplication, adapter))
+      yield* backend.ready
+      const sql = (text, params = []) => client.unsafe(text, params)
+      const services = yield* Authority.make(schema).pipe(
+        Effect.provideService(SqlClient, client)
+      )
+      const command = yield* Persistence.make.pipe(
+        Effect.provideService(CommandTransactions, services.transactions),
+        Effect.provideService(JobEnqueue, backend.producer)
+      )
+      const provider = yield* Provider.make(schema).pipe(
+        Effect.provideService(SqlClient, client)
+      )
+      const issue = () => services.authority.issue()
+      const authenticate = (issued) => services.authority.authenticate(issued.credential)
+      const a = yield* issue()
+      yield* sql(`UPDATE ${schema}.sandboxes SET next_generation_at=expires_at`)
+      const access = yield* authenticate(a)
+      const current = () => access.sandbox.ref
+      const run = (requestId, scenario = "success", count = 1) =>
+        command.run(access, { sandbox: current(), requestId, scenario, count })
+      const queryJob = (id) =>
+        sql(`SELECT * FROM ${schema}.jobs WHERE id=$1`, [id]).pipe(
+          Effect.map((rows) => rows[0])
+        )
+      const shortPolicy = Policy.make({
+        leaseDuration: Duration.millis(1800),
+        attemptTimeout: Duration.millis(200),
+        retryDelay: Duration.millis(500),
+        maxAttempts: 3
+      })
+      const produce = (id, behavior = "success", availableAt) =>
+        backend.withTransaction(() =>
+          Effect.gen(function* () {
+            const [job] = yield* Plan.plan(
+              { sandbox: current(), requestId: id, scenario: "success", count: 1 },
+              current(),
+              0,
+              availableAt
+            )
+            const produced = yield* Plan.enqueue({
+              ...job,
+              policy: shortPolicy,
+              payload: { ...job.payload, behavior }
+            })
+            yield* sql(
+              `UPDATE ${schema}.sandboxes SET retained_jobs=retained_jobs+1 WHERE sandbox_id=$1`,
+              [current().sandboxId]
+            )
+            yield* sql(
+              `INSERT INTO ${schema}.associations VALUES ($1,$2,$3,'{}'::jsonb)`,
+              [current().sandboxId, current().generation, produced.jobId]
+            )
+            return {
+              jobId: produced.jobId,
+              job: { ...job, payload: { ...job.payload, behavior } }
+            }
+          })
+        )
+      const providerCommand = (job) =>
+        Codec.encodeJobPayload(Definitions.Payload, job.payload).pipe(
+          Effect.map((encoded) => ({
+            sandbox: job.payload.sandbox,
+            producer: job.producer,
+            workload: job.workload,
+            behavior: job.payload.behavior,
+            semanticProjection: encoded.semanticProjectionBytes
+          }))
+        )
+      let hints = 0
+      const workerLayer = Application.layerNoDeps(schema).pipe(
+        Layer.provide(Layer.succeed(Backend.PostgreSqlJobs, backend))
+      )
+      const wake = (queue = "playground-communications") =>
+        Executor.run(schema, queue).pipe(
+          Effect.provide(workerLayer),
+          Effect.provideService(CommandPersistence, command),
+          Effect.provideService(SqlClient, client),
+          Effect.provideService(WakeAlarm, alarm),
+          Effect.provideService(Executor.ExecutionHints, {
+            reconcile: Effect.sync(() => {
+              hints++
+            })
+          })
+        )
+
+      const initial = yield* run("dedup", "deduplication", 6)
+      assert.equal(initial._tag, "Committed")
+      assert.deepEqual(yield* run("dedup", "deduplication", 6), initial)
+      assert.equal((yield* sql(`SELECT count(*)::int AS n FROM ${schema}.jobs`))[0].n, 6)
+      const queues = yield* Executor.consumers
+      assert.deepEqual(
+        queues.map((q) => q.queue.name),
+        Executor.queueNames
+      )
+      for (const queue of Executor.queueNames) {
+        yield* wake(queue)
+      }
+      assert(
+        (yield* sql(`SELECT state FROM ${schema}.jobs`)).every(
+          (r) => r.state === "Completed"
+        )
+      )
+      assert.equal(
+        (yield* sql(
+          `SELECT count(*)::int AS n FROM ${schema}.provider_ledger WHERE accepted=true`
+        ))[0].n,
+        6
+      )
+      assert.equal(hints, 4)
+      checks.push(
+        "actual four fixed consumers, six real handlers, private codec, durable completion and hints"
+      )
+
+      const retry = yield* produce("retry", "retry-then-success")
+      yield* wake()
+      assert.equal((yield* queryJob(retry.jobId)).state, "RetryScheduled")
+      yield* wake()
+      assert.equal((yield* queryJob(retry.jobId)).state, "RetryScheduled")
+      yield* Effect.sleep("600 millis")
+      yield* wake()
+      assert.equal((yield* queryJob(retry.jobId)).state, "Completed")
+      const now = Number(
+        (yield* sql(
+          "SELECT floor(extract(epoch FROM clock_timestamp())*1000)::bigint AS now"
+        ))[0].now
+      )
+      const delayed = yield* produce("delay", "success", now + 700)
+      yield* wake()
+      assert.equal((yield* queryJob(delayed.jobId)).state, "Pending")
+      yield* Effect.sleep("800 millis")
+      yield* wake()
+      assert.equal((yield* queryJob(delayed.jobId)).state, "Completed")
+      checks.push("DB-time delayed and retry wake cycles with actual scenario consumers")
+
+      const lost = yield* produce("lost", "accepted-response-lost")
+      const pc = yield* providerCommand(lost.job)
+      assert.equal((yield* Effect.flip(provider.execute(pc)))._tag, "ResponseLost")
+      const raced = yield* Effect.all([provider.execute(pc), provider.execute(pc)], {
+        concurrency: 2
+      })
+      assert.equal(raced.length, 2)
+      const entry = (yield* sql(
+        `SELECT * FROM ${schema}.provider_ledger WHERE job_id=$1`,
+        [lost.jobId]
+      ))[0]
+      assert.equal(entry.accepted, true)
+      assert.equal(entry.invocations, 3)
+      yield* wake()
+      assert.equal((yield* queryJob(lost.jobId)).state, "Completed")
+      const conflict = yield* Effect.flip(
+        provider.execute({ ...pc, semanticProjection: new Uint8Array([42]) })
+      )
+      assert.equal(conflict._tag, "PayloadConflict")
+      checks.push(
+        "response loss after durable acceptance; concurrent ledger retries cause one synthetic effect"
+      )
+
+      const unknownWorker = yield* produce("unknown-worker", "accepted-response-lost")
+      yield* wake()
+      assert.equal((yield* queryJob(unknownWorker.jobId)).state, "Active")
+      yield* Effect.sleep("1900 millis")
+      yield* wake()
+      assert.equal((yield* queryJob(unknownWorker.jobId)).state, "Completed")
+      const dead = yield* produce("dead-worker", "dead")
+      const isolated = yield* produce("isolated-worker", "isolated")
+      yield* wake()
+      assert.equal((yield* queryJob(dead.jobId)).state, "Dead")
+      assert.equal((yield* queryJob(isolated.jobId)).state, "Isolated")
+      checks.push(
+        "real OutcomeUnknown retains ownership until recovery; durable dead/isolated handlers"
+      )
+      const recovering = yield* produce("recover")
+      const old = yield* backend.store.claim({
+        queue: Definitions.WelcomeEmail.queue.name,
+        supportedCatalog: [Definitions.WelcomeEmail.catalog],
+        leaseToken: crypto.randomUUID()
+      })
+      assert.equal(old._tag, "Claimed")
+      yield* Effect.sleep("1900 millis")
+      yield* wake()
+      assert.equal((yield* queryJob(recovering.jobId)).state, "Completed")
+      const stale = yield* Effect.exit(
+        backend.store.finalize({
+          ownership: old.claim.ownership,
+          before: old.claim.snapshot,
+          finalization: { _tag: "Complete" }
+        })
+      )
+      assert(Exit.isFailure(stale))
+      checks.push("bounded actual expired-lease recovery and stale finalization fencing")
+
+      // Zero viewers retires ALL fixed queues; renewing describe resumes the same generation.
+      yield* sql(`UPDATE ${schema}.sandboxes SET viewer_until=0`)
+      const paused = yield* produce("paused")
+      assert.equal((yield* wake())._tag, "Retired")
+      assert.equal((yield* queryJob(paused.jobId)).state, "Pending")
+      yield* services.authority.describe(access)
+      yield* wake()
+      assert.equal((yield* queryJob(paused.jobId)).state, "Completed")
+      yield* sql(
+        `UPDATE ${schema}.sandboxes SET next_generation_at=0 WHERE sandbox_id=$1`,
+        [current().sandboxId]
+      )
+      const beforeCount = (yield* sql(`SELECT count(*)::int AS n FROM ${schema}.jobs`))[0]
+        .n
+      yield* wake()
+      assert.equal(
+        (yield* sql(`SELECT count(*)::int AS n FROM ${schema}.jobs`))[0].n,
+        beforeCount + 1
+      )
+      yield* wake()
+      assert.equal(
+        (yield* sql(`SELECT count(*)::int AS n FROM ${schema}.jobs`))[0].n,
+        beforeCount + 1
+      )
+      checks.push(
+        "unattended global retirement, describe reactivation, bounded due generation"
+      )
+
+      return { status: "PASS", checks, hosted: "NotTested", scheduledAlarm: "NotTested" }
+    }).pipe(Effect.provide(Documents.keysLayer))
+  ).pipe(Effect.provide(Reactivity.layer), Effect.timeout("50 seconds"))
diff --git a/apps/playground-worker/tests/execution/Harness.mjs b/apps/playground-worker/tests/execution/Harness.mjs
new file mode 100644
index 0000000..c49b20f
--- /dev/null
+++ b/apps/playground-worker/tests/execution/Harness.mjs
@@ -0,0 +1,114 @@
+// Filesystem/native harness FFI; no credentials or raw driver errors in receipts.
+import assert from "node:assert/strict"
+import { readFileSync, writeFileSync } from "node:fs"
+import { Effect } from "effect"
+import { Pool } from "pg"
+import * as Jobs from "effect-jobs/PostgreSqlSchema"
+import * as Authority from "./dist/src/persistence/authority/Schema.js"
+import { Miniflare, convertV4MiniflareOptions } from "miniflare"
+import { probe } from "./Probe.mjs"
+const cfg = JSON.parse(readFileSync(process.env.EXECUTOR_PRIVATE_CONFIG, "utf8"))
+const evidence = process.env.EXECUTOR_EVIDENCE
+const runtime = process.versions.bun ? "bun" : "node"
+const report = {
+  runtime,
+  version: process.versions.bun ?? process.version,
+  startedAt: new Date().toISOString(),
+  checks: [],
+  hosted: "NotTested"
+}
+const url = `postgres://${cfg.user}:${cfg.password}@127.0.0.1:${cfg.port}/${cfg.database}`
+const admin = new Pool({
+  ...cfg,
+  host: "127.0.0.1",
+  connectionTimeoutMillis: 2000,
+  statement_timeout: 10000
+})
+const schemas =
+  runtime === "node" ? ["executor_node", "executor_workerd"] : ["executor_bun"]
+let mf
+try {
+  report.serverVersion = (await admin.query("SHOW server_version")).rows[0].server_version
+  assert.match(report.serverVersion, /^16\.15/)
+  for (const schema of schemas) {
+    await admin.query(`CREATE SCHEMA ${schema}`)
+    await admin.query(Jobs.migration(Jobs.tables({ schema })))
+    await admin.query(Authority.proposal(schema))
+  }
+  let alarmAt = null
+  report.local = await Effect.runPromise(
+    probe(
+      url,
+      `executor_${runtime}`,
+      {
+        set: (at) =>
+          Effect.sync(() => {
+            alarmAt = at
+          }),
+        clear: Effect.sync(() => {
+          alarmAt = null
+        })
+      },
+      report.checks
+    )
+  )
+  assert(alarmAt !== null)
+  if (runtime === "node") {
+    mf = new Miniflare(
+      convertV4MiniflareOptions({
+        modules: true,
+        script: readFileSync("Worker.js", "utf8"),
+        compatibilityDate: "2026-10-01",
+        compatibilityFlags: ["nodejs_compat"],
+        durableObjects: { PROBE: { className: "Probe", useSQLite: true } },
+        durableObjectsPersist: false,
+        hyperdrives: { PG: url },
+        outboundService: () => new Response("HTTP denied", { status: 403 })
+      })
+    )
+    const response = await mf.dispatchFetch("https://probe.invalid/executor")
+    report.workerd = await response.json()
+    assert.equal(response.status, 200)
+    assert.equal(report.workerd.status, "PASS")
+    assert.equal(report.workerd.nativeAlarmSet, true)
+  }
+  report.status = "PASS"
+} catch (error) {
+  report.status = "FAIL"
+  report.failureClass = error?.constructor?.name ?? "Unknown"
+  report.frames = String(error?.stack ?? "")
+    .split("\n")
+    .filter((line) => line.trim().startsWith("at "))
+    .map((line) => line.replace(/postgres[^ ]*/g, "[redacted]"))
+  if (error?.code === "ERR_ASSERTION") {
+    report.assertion = {
+      actual: error.actual,
+      expected: error.expected,
+      operator: error.operator
+    }
+  }
+  process.exitCode = 1
+} finally {
+  if (mf) {
+    await mf.dispose()
+  }
+  report.remainingSessions = (
+    await admin.query(
+      "SELECT count(*)::int AS n FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid()"
+    )
+  ).rows[0].n
+  if (report.remainingSessions !== 0) {
+    report.status = "FAIL"
+    process.exitCode = 1
+  }
+  for (const schema of schemas) {
+    await admin.query(`DROP SCHEMA IF EXISTS ${schema} CASCADE`)
+  }
+  await admin.end()
+  report.finishedAt = new Date().toISOString()
+  writeFileSync(
+    `${evidence}/${runtime}-receipt.json`,
+    JSON.stringify(report, null, 2) + "\n"
+  )
+  console.log(JSON.stringify(report))
+}
