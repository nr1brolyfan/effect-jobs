diff --git a/apps/playground-worker/src/persistence/authority/PostgreSqlAuthority.ts b/apps/playground-worker/src/persistence/authority/PostgreSqlAuthority.ts
new file mode 100644
index 0000000..0a62c0f
--- /dev/null
+++ b/apps/playground-worker/src/persistence/authority/PostgreSqlAuthority.ts
@@ -0,0 +1,321 @@
+// The application supplies the exact PgClient's SqlClient service and native adapter.
+// @effect-diagnostics unstableApiUsage:off
+import { Cause, Effect, Layer, Option, Redacted, Schema } from "effect"
+import { SqlClient } from "effect/sql/SqlClient"
+import { isSqlError, type SqlError } from "effect/sql/SqlError"
+import {
+  SandboxAuthority,
+  PlaygroundError
+} from "@effect-jobs/playground-contracts/Services"
+import { SandboxView, limits } from "@effect-jobs/playground-contracts/Sandbox"
+import type { SandboxAccess, SandboxRef } from "@effect-jobs/playground-contracts/Sandbox"
+import {
+  CommandTransactions,
+  CommandTransactionFailure,
+  StoredReceipt
+} from "../commands/Transactions.js"
+import * as Tables from "./Schema.js"
+
+export const viewerMillis = 15_000
+const dbTime = "floor(extract(epoch FROM clock_timestamp())*1000)::bigint"
+const fail = (code: PlaygroundError["code"]) => new PlaygroundError({ code })
+const controls = <A, E, R>(effect: Effect.Effect<A, E | SqlError, R>) =>
+  effect.pipe(
+    Effect.catchCause((cause) =>
+      Effect.failCause(
+        Cause.fromReasons<E | CommandTransactionFailure>(
+          cause.reasons.map((reason) => {
+            if (
+              (Cause.isFailReason(reason) && isSqlError(reason.error)) ||
+              (Cause.isDieReason(reason) && isSqlError(reason.defect))
+            ) {
+              return Cause.makeFailReason(
+                new CommandTransactionFailure({ commitKnowledge: "Unknown" })
+              )
+            }
+            return reason as Cause.Reason<E>
+          })
+        )
+      )
+    )
+  )
+const digest = (value: string) =>
+  Effect.tryPromise({
+    try: async () =>
+      Array.from(
+        new Uint8Array(
+          await crypto.subtle.digest("SHA-256", new TextEncoder().encode(value))
+        ),
+        (byte) => byte.toString(16).padStart(2, "0")
+      ).join(""),
+    catch: () => fail("unavailable")
+  })
+const view = (row: Record<string, unknown>) =>
+  Schema.decodeUnknownEffect(SandboxView)(
+    {
+      ref: { sandboxId: row.sandbox_id, generation: Number(row.generation) },
+      expiresAt: Number(row.expires_at),
+      capabilities: {
+        runScenario: true,
+        resetSandbox: true,
+        retryJob: false,
+        redriveJob: false,
+        cancelJob: false
+      }
+    },
+    { onExcessProperty: "error" }
+  ).pipe(Effect.mapError(() => fail("unavailable")))
+
+export const make = (schema: string) =>
+  Effect.gen(function* () {
+    const sql = yield* SqlClient
+    const t = Tables.relations(schema)
+    const query = (text: string, values: ReadonlyArray<unknown> = []) =>
+      sql
+        .unsafe<Record<string, unknown>>(text, values)
+        .pipe(
+          Effect.mapError(
+            () => new CommandTransactionFailure({ commitKnowledge: "Unknown" })
+          )
+        )
+    const locked = (id: string) =>
+      Effect.gen(function* () {
+        const rows = yield* query(
+          `SELECT * FROM ${t.sandboxes} WHERE sandbox_id=$1 FOR UPDATE`,
+          [id]
+        )
+        const [clock] = yield* query(`SELECT ${dbTime} AS db_now`)
+        return rows.map((row) => ({ ...row, db_now: clock!.db_now }))
+      })
+    const guard = (rows: ReadonlyArray<Record<string, unknown>>, expected?: SandboxRef) =>
+      Effect.gen(function* () {
+        const row = rows[0]
+        if (!row) {
+          return yield* fail("not-found")
+        }
+        if (Number(row.expires_at) <= Number(row.db_now)) {
+          return yield* fail("sandbox-expired")
+        }
+        if (expected && Number(row.generation) !== expected.generation) {
+          return yield* fail("stale-generation")
+        }
+        return row
+      })
+    const publicEffect = <A, E, R>(effect: Effect.Effect<A, E, R>) =>
+      effect.pipe(
+        Effect.mapError((error) =>
+          error instanceof PlaygroundError ? error : fail("unavailable")
+        )
+      )
+    const renew = (access: SandboxAccess) =>
+      sql
+        .withTransaction(
+          Effect.gen(function* () {
+            const row = yield* guard(
+              yield* locked(access.sandbox.ref.sandboxId),
+              access.sandbox.ref
+            )
+            yield* query(
+              `UPDATE ${t.sandboxes} SET viewer_until=LEAST(expires_at,$2::bigint+$3::bigint) WHERE sandbox_id=$1`,
+              [row.sandbox_id, row.db_now, viewerMillis]
+            )
+            return yield* view(row)
+          })
+        )
+        .pipe(publicEffect)
+    const authority = SandboxAuthority.of({
+      issue: () =>
+        Effect.gen(function* () {
+          const credential = yield* Effect.sync(() =>
+            Array.from(crypto.getRandomValues(new Uint8Array(32)), (byte) =>
+              byte.toString(16).padStart(2, "0")
+            ).join("")
+          )
+          const hash = yield* digest(credential)
+          const id = yield* Effect.sync(() => crypto.randomUUID())
+          const rows = yield* query(
+            `INSERT INTO ${t.sandboxes}(sandbox_id,generation,expires_at,credential_hash,viewer_until,next_generation_at)
+        VALUES ($1,1,${dbTime}+$3::bigint,$2,${dbTime}+$4::bigint,${dbTime}+5000) RETURNING *`,
+            [id, hash, limits.sandboxLifetimeMillis, viewerMillis]
+          )
+          return { sandbox: yield* view(rows[0]!), credential: Redacted.make(credential) }
+        }).pipe(publicEffect),
+      authenticate: (credential) =>
+        Effect.gen(function* () {
+          if (!/^[0-9a-f]{64}$/.test(Redacted.value(credential))) {
+            return yield* fail("not-found")
+          }
+          const hash = yield* digest(Redacted.value(credential))
+          const row = yield* guard(
+            yield* query(
+              `SELECT *,${dbTime} AS db_now FROM ${t.sandboxes} WHERE credential_hash=$1`,
+              [hash]
+            )
+          )
+          return { sandbox: yield* view(row) }
+        }).pipe(publicEffect),
+      describe: renew
+    })
+    const receipt = (ref: SandboxRef, requestId: string, operation: string) =>
+      query(
+        `SELECT receipt FROM ${t.receipts} WHERE sandbox_id=$1 AND generation=$2 AND operation=$3 AND request_id=$4`,
+        [ref.sandboxId, ref.generation, operation, requestId]
+      ).pipe(
+        Effect.flatMap((rows) =>
+          rows[0]
+            ? Schema.decodeUnknownEffect(StoredReceipt)(rows[0].receipt, {
+                onExcessProperty: "error"
+              }).pipe(Effect.mapError(() => fail("unavailable")))
+            : Effect.succeed(null)
+        )
+      )
+    const transactions = CommandTransactions.of({
+      owned: (access, request, operation, body) =>
+        Effect.gen(function* () {
+          if (Option.isSome(yield* Effect.serviceOption(sql.transactionService))) {
+            return yield* new CommandTransactionFailure({
+              commitKnowledge: "NotCommitted"
+            })
+          }
+          if (request.sandbox.sandboxId !== access.sandbox.ref.sandboxId) {
+            return yield* fail("not-found")
+          }
+          // Persist first admission separately. Receipt absence NEVER grants write replay.
+          const fresh = yield* controls(
+            sql.withTransaction(
+              Effect.gen(function* () {
+                yield* guard(yield* locked(request.sandbox.sandboxId))
+                const prior = yield* query(
+                  `SELECT request_id FROM ${t.admission} WHERE sandbox_id=$1 AND generation=$2 AND operation=$3 AND request_id=$4`,
+                  [
+                    request.sandbox.sandboxId,
+                    request.sandbox.generation,
+                    operation,
+                    request.requestId
+                  ]
+                )
+                if (prior.length) {
+                  return false
+                }
+                const [budget] = yield* query(
+                  `SELECT count(*)::int AS n FROM ${t.admission} WHERE sandbox_id=$1`,
+                  [request.sandbox.sandboxId]
+                )
+                if (Number(budget!.n) >= 200) {
+                  return yield* fail("limit-reached")
+                }
+                const inserted = yield* query(
+                  `INSERT INTO ${t.admission} VALUES ($1,$2,$3,$4) ON CONFLICT DO NOTHING RETURNING request_id`,
+                  [
+                    request.sandbox.sandboxId,
+                    request.sandbox.generation,
+                    operation,
+                    request.requestId
+                  ]
+                )
+                return inserted.length === 1
+              })
+            )
+          )
+          return yield* controls(
+            sql.withTransaction(
+              Effect.gen(function* () {
+                const row = yield* guard(yield* locked(request.sandbox.sandboxId))
+                if (
+                  request.requestId.startsWith("auto-") &&
+                  Number(row.viewer_until) <= Number(row.db_now)
+                ) {
+                  return yield* fail("sandbox-expired")
+                }
+                const current = (yield* view(row)).ref
+                return yield* body({
+                  admission: fresh ? "Fresh" : "Unresolved",
+                  current,
+                  dbNow: Number(row.db_now),
+                  expiresAt: Number(row.expires_at),
+                  receipt: (req, op) => receipt(req.sandbox, req.requestId, op),
+                  reserve: (count) =>
+                    Effect.gen(function* () {
+                      if (!Number.isInteger(count) || count < 1 || count > 10) {
+                        return yield* fail("limit-reached")
+                      }
+                      const reserved = yield* query(
+                        `UPDATE ${t.sandboxes} SET retained_jobs=retained_jobs+$2::int
+              WHERE sandbox_id=$1 AND retained_jobs+$2::int<=100 RETURNING sandbox_id`,
+                        [current.sandboxId, count]
+                      )
+                      if (!reserved.length) {
+                        return yield* fail("limit-reached")
+                      }
+                    }),
+                  associate: (jobId, job) =>
+                    query(`INSERT INTO ${t.associations} VALUES ($1,$2,$3,$4::jsonb)`, [
+                      current.sandboxId,
+                      current.generation,
+                      jobId,
+                      JSON.stringify({
+                        syntheticActor: job.payload.actor,
+                        syntheticOrderId: job.payload.order
+                      })
+                    ]).pipe(Effect.asVoid),
+                  advanceGeneration: (expected) =>
+                    Effect.gen(function* () {
+                      const updated = yield* query(
+                        `UPDATE ${t.sandboxes} SET generation=generation+1, next_generation_at=${dbTime}+5000
+              WHERE sandbox_id=$1 AND generation=$2 AND generation<9007199254740991 RETURNING *`,
+                        [expected.sandboxId, expected.generation]
+                      )
+                      if (!updated.length) {
+                        return yield* fail("stale-generation")
+                      }
+                      return (yield* view(updated[0]!)).ref
+                    }),
+                  saveReceipt: (value) =>
+                    query(`INSERT INTO ${t.receipts} VALUES ($1,$2,$3,$4,$5::jsonb)`, [
+                      request.sandbox.sandboxId,
+                      request.sandbox.generation,
+                      operation,
+                      request.requestId,
+                      JSON.stringify(value)
+                    ]).pipe(Effect.asVoid),
+                  audit: (entry) =>
+                    query(`INSERT INTO ${t.audit} VALUES ($1,$2,$3,$4,$5,${dbTime})`, [
+                      current.sandboxId,
+                      current.generation,
+                      entry.operation,
+                      entry.reason,
+                      entry.count
+                    ]).pipe(Effect.asVoid)
+                })
+              })
+            )
+          )
+        }),
+      lookup: (access, request, operation) =>
+        controls(
+          sql.withTransaction(
+            Effect.gen(function* () {
+              if (request.sandbox.sandboxId !== access.sandbox.ref.sandboxId) {
+                return yield* fail("not-found")
+              }
+              const row = yield* guard(yield* locked(request.sandbox.sandboxId))
+              if (request.sandbox.generation > Number(row.generation)) {
+                return yield* fail("stale-generation")
+              }
+              return yield* receipt(request.sandbox, request.requestId, operation)
+            })
+          )
+        )
+    })
+    return { authority, transactions }
+  })
+export const authorityLayerNoDeps = (schema: string) =>
+  Layer.effect(
+    SandboxAuthority,
+    make(schema).pipe(Effect.map((services) => services.authority))
+  )
+export const transactionsLayerNoDeps = (schema: string) =>
+  Layer.effect(
+    CommandTransactions,
+    make(schema).pipe(Effect.map((services) => services.transactions))
+  )
diff --git a/apps/playground-worker/src/persistence/authority/Schema.ts b/apps/playground-worker/src/persistence/authority/Schema.ts
new file mode 100644
index 0000000..500445d
--- /dev/null
+++ b/apps/playground-worker/src/persistence/authority/Schema.ts
@@ -0,0 +1,63 @@
+// App-owned DDL proposal. The serial migration owner invokes this explicitly.
+// No lifecycle writes, migrations or pools start on import.
+export const relations = (schema: string) => {
+  if (!/^[a-z][a-z0-9_]{0,62}$/.test(schema)) {
+    throw new Error("Invalid playground schema")
+  }
+  const table = (name: string) => `"${schema}"."${name}"`
+  return {
+    sandboxes: table("sandboxes"),
+    associations: table("associations"),
+    receipts: table("command_receipts"),
+    admission: table("command_admission"),
+    audit: table("command_audit"),
+    ledger: table("provider_ledger"),
+    jobs: table("jobs")
+  }
+}
+export const proposal = (schema: string) => {
+  const t = relations(schema)
+  return `CREATE TABLE ${t.sandboxes} (
+    sandbox_id text PRIMARY KEY,
+    generation bigint NOT NULL CHECK (generation BETWEEN 1 AND 9007199254740991),
+    expires_at bigint NOT NULL,
+    credential_hash text NOT NULL UNIQUE,
+    viewer_until bigint NOT NULL DEFAULT 0,
+    next_generation_at bigint NOT NULL DEFAULT 0,
+    retained_jobs integer NOT NULL DEFAULT 0 CHECK (retained_jobs BETWEEN 0 AND 100)
+  );
+  CREATE TABLE ${t.associations} (
+    sandbox_id text NOT NULL REFERENCES ${t.sandboxes}(sandbox_id),
+    generation bigint NOT NULL,
+    job_id text NOT NULL UNIQUE REFERENCES ${t.jobs}(id),
+    relations jsonb NOT NULL,
+    PRIMARY KEY (sandbox_id,generation,job_id)
+  );
+  CREATE TABLE ${t.admission} (
+    sandbox_id text NOT NULL REFERENCES ${t.sandboxes}(sandbox_id),
+    generation bigint NOT NULL, operation text NOT NULL, request_id text NOT NULL,
+    PRIMARY KEY (sandbox_id,generation,operation,request_id)
+  );
+  CREATE TABLE ${t.receipts} (
+    sandbox_id text NOT NULL, generation bigint NOT NULL,
+    operation text NOT NULL, request_id text NOT NULL, receipt jsonb NOT NULL,
+    PRIMARY KEY (sandbox_id,generation,operation,request_id),
+    FOREIGN KEY (sandbox_id,generation,operation,request_id)
+      REFERENCES ${t.admission}(sandbox_id,generation,operation,request_id)
+  );
+  CREATE TABLE ${t.audit} (
+    sandbox_id text NOT NULL REFERENCES ${t.sandboxes}(sandbox_id),
+    generation bigint NOT NULL, operation text NOT NULL, reason text NOT NULL,
+    count integer NOT NULL CHECK (count BETWEEN 0 AND 10), observed_at bigint NOT NULL
+  );
+  CREATE TABLE ${t.ledger} (
+    sandbox_id text NOT NULL, generation bigint NOT NULL,
+    job_id text NOT NULL UNIQUE REFERENCES ${t.jobs}(id),
+    signature text NOT NULL, accepted boolean NOT NULL, invocations integer NOT NULL,
+    PRIMARY KEY (sandbox_id,generation,job_id),
+    FOREIGN KEY (sandbox_id,generation,job_id)
+      REFERENCES ${t.associations}(sandbox_id,generation,job_id)
+  );
+  CREATE INDEX ON ${t.associations}(sandbox_id,generation);
+  CREATE INDEX ON ${t.sandboxes}(viewer_until);`
+}
diff --git a/apps/playground-worker/src/persistence/commands/Persistence.ts b/apps/playground-worker/src/persistence/commands/Persistence.ts
new file mode 100644
index 0000000..8677f3b
--- /dev/null
+++ b/apps/playground-worker/src/persistence/commands/Persistence.ts
@@ -0,0 +1,334 @@
+import { Cause, Effect, Layer, Schema } from "effect"
+import { EpochMillis } from "effect-jobs/JobPolicy"
+import { JobBackendError, JobEnqueue } from "effect-jobs/JobEnqueue"
+import { SandboxRef } from "@effect-jobs/playground-contracts/Sandbox"
+import type { SandboxAccess } from "@effect-jobs/playground-contracts/Sandbox"
+import {
+  ReceiptRequest,
+  ResetCommand,
+  ResetResult,
+  ScenarioCommand,
+  ScenarioResult
+} from "@effect-jobs/playground-contracts/Scenarios"
+import { PlaygroundError } from "@effect-jobs/playground-contracts/Services"
+import * as Plan from "../../scenarios/Plan.js"
+import { DocumentKeys } from "../../scenarios/PrivateDocument.js"
+import {
+  CommandPersistence,
+  CommandTransactionFailure,
+  CommandTransactions,
+  StoredReceipt
+} from "./Transactions.js"
+import type { CommandTransaction } from "./Transactions.js"
+
+const fail = (code: PlaygroundError["code"]) => new PlaygroundError({ code })
+const decode = <S extends Schema.Top & { readonly DecodingServices: never }>(
+  schema: S,
+  input: unknown,
+  code: PlaygroundError["code"] = "invalid-request"
+) =>
+  Schema.decodeUnknownEffect(schema)(input, { onExcessProperty: "error" }).pipe(
+    Effect.mapError(() => fail(code))
+  )
+// Only a single expected failure can authorize Unknown recovery. All lifecycle
+// reasons survive sanitization, including interruption and a fresh bounded Die.
+const sanitizeCause = (cause: Cause.Cause<unknown>) =>
+  Cause.fromReasons(
+    cause.reasons.map((reason): Cause.Reason<PlaygroundError> => {
+      if (Cause.isInterruptReason(reason)) {
+        return reason
+      }
+      if (Cause.isDieReason(reason)) {
+        return Cause.makeDieReason(new Error("Command persistence defect"))
+      }
+      return Cause.makeFailReason(
+        fail(reason.error instanceof PlaygroundError ? reason.error.code : "unavailable")
+      )
+    })
+  )
+const recoverMutation = <A>(
+  cause: Cause.Cause<unknown>,
+  unknown: A,
+  producer = false
+) => {
+  const reason = cause.reasons.length === 1 ? cause.reasons[0] : undefined
+  if (
+    reason !== undefined &&
+    Cause.isFailReason(reason) &&
+    (reason.error instanceof CommandTransactionFailure ||
+      (producer && reason.error instanceof JobBackendError)) &&
+    reason.error.commitKnowledge === "Unknown"
+  ) {
+    return Effect.succeed(unknown)
+  }
+  return Effect.failCause(sanitizeCause(cause))
+}
+
+const sameRef = (a: SandboxRef, b: SandboxRef) =>
+  a.sandboxId === b.sandboxId && a.generation === b.generation
+
+const guard = Effect.fnUntraced(function* (
+  access: SandboxAccess,
+  expected: SandboxRef,
+  tx: CommandTransaction
+) {
+  const current = yield* decode(SandboxRef, tx.current, "unavailable")
+  yield* decode(EpochMillis, tx.dbNow, "unavailable")
+  yield* decode(EpochMillis, tx.expiresAt, "unavailable")
+  if (
+    current.sandboxId !== access.sandbox.ref.sandboxId ||
+    expected.sandboxId !== current.sandboxId
+  ) {
+    return yield* fail("not-found")
+  }
+  if (tx.expiresAt <= tx.dbNow) {
+    return yield* fail("sandbox-expired")
+  }
+  // Receipt reads for an earlier reset are permitted; the owning write guard is later.
+  if (expected.generation > current.generation) {
+    return yield* fail("stale-generation")
+  }
+  return current
+})
+
+const validateReceipt = Effect.fnUntraced(function* (
+  raw: unknown,
+  request: ReceiptRequest,
+  operation: "Scenario" | "Reset"
+) {
+  const receipt = yield* decode(StoredReceipt, raw, "unavailable")
+  const ref =
+    receipt.result._tag === "Committed" && receipt._tag === "Scenario"
+      ? receipt.result.sandbox
+      : receipt._tag === "Reset"
+        ? receipt.result.previous
+        : receipt.command.sandbox
+  if (
+    receipt._tag !== operation ||
+    receipt.result._tag !== "Committed" ||
+    receipt.command.requestId !== request.requestId ||
+    receipt.result.requestId !== request.requestId ||
+    !sameRef(receipt.command.sandbox, request.sandbox) ||
+    !sameRef(ref, request.sandbox)
+  ) {
+    return yield* fail("unavailable")
+  }
+  if (
+    receipt._tag === "Scenario" &&
+    receipt.result.jobIds.length !== receipt.command.count
+  ) {
+    return yield* fail("unavailable")
+  }
+  return receipt
+})
+
+export const make = Effect.gen(function* () {
+  const transactions = yield* CommandTransactions
+  const producer = yield* JobEnqueue
+  const keys = yield* DocumentKeys
+  const enqueue = (job: Plan.PlannedJob) =>
+    Plan.enqueue(job).pipe(
+      Effect.provideService(JobEnqueue, producer),
+      Effect.provideService(DocumentKeys, keys)
+    )
+  const run = Effect.fn("Commands.persistScenario")(function* (
+    access: SandboxAccess,
+    input: ScenarioCommand
+  ) {
+    const command = yield* decode(ScenarioCommand, input)
+    // Planning has no writes. The seed is fixed server configuration, never client input.
+    const jobs = yield* Plan.plan(command, access.sandbox.ref, 0).pipe(
+      Effect.mapError(() => fail("invalid-request"))
+    )
+    return yield* transactions
+      .owned(access, command, "Scenario", (tx) =>
+        Effect.gen(function* () {
+          const current = yield* guard(access, command.sandbox, tx)
+          const stored = yield* tx.receipt(command, "Scenario")
+          if (stored !== null) {
+            const receipt = yield* validateReceipt(stored, command, "Scenario")
+            if (
+              receipt._tag !== "Scenario" ||
+              receipt.command.scenario !== command.scenario ||
+              receipt.command.count !== command.count
+            ) {
+              return yield* fail("invalid-request")
+            }
+            return receipt.result
+          }
+          if (!sameRef(current, command.sandbox)) {
+            return yield* fail("stale-generation")
+          }
+          if (tx.admission === "Unresolved") {
+            return {
+              _tag: "OutcomeUnknown" as const,
+              sandbox: command.sandbox,
+              requestId: command.requestId
+            }
+          }
+          yield* tx.reserve(jobs.length)
+          const jobIds = []
+          for (const job of jobs) {
+            const produced = yield* enqueue(job)
+            if (command.scenario === "deduplication") {
+              const duplicate = yield* enqueue(job)
+              if (
+                duplicate.jobId !== produced.jobId ||
+                duplicate._tag !== "AlreadyPresent"
+              ) {
+                return yield* fail("unavailable")
+              }
+            }
+            yield* tx.associate(produced.jobId, job)
+            jobIds.push(produced.jobId)
+          }
+          const result = yield* decode(
+            ScenarioResult.members[0],
+            {
+              _tag: "Committed",
+              sandbox: command.sandbox,
+              requestId: command.requestId,
+              jobIds
+            },
+            "unavailable"
+          )
+          yield* tx.audit({
+            operation: "Scenario",
+            reason: "synthetic-scenario",
+            count: jobs.length
+          })
+          yield* tx.saveReceipt({ _tag: "Scenario", command, result })
+          return result
+        })
+      )
+      .pipe(
+        Effect.catchCause((cause) =>
+          recoverMutation(
+            cause,
+            {
+              _tag: "OutcomeUnknown" as const,
+              sandbox: command.sandbox,
+              requestId: command.requestId
+            },
+            true
+          )
+        )
+      )
+  })
+  const reset = Effect.fn("Commands.persistReset")(function* (
+    access: SandboxAccess,
+    input: ResetCommand
+  ) {
+    const command = yield* decode(ResetCommand, input)
+    return yield* transactions
+      .owned(access, command, "Reset", (tx) =>
+        Effect.gen(function* () {
+          const current = yield* guard(access, command.sandbox, tx)
+          const stored = yield* tx.receipt(command, "Reset")
+          if (stored !== null) {
+            const receipt = yield* validateReceipt(stored, command, "Reset")
+            if (receipt._tag !== "Reset") {
+              return yield* fail("unavailable")
+            }
+            return receipt.result
+          }
+          if (!sameRef(current, command.sandbox)) {
+            return yield* fail("stale-generation")
+          }
+          if (tx.admission === "Unresolved") {
+            return {
+              _tag: "OutcomeUnknown" as const,
+              previous: command.sandbox,
+              requestId: command.requestId
+            }
+          }
+          if (current.generation === Number.MAX_SAFE_INTEGER) {
+            return yield* fail("limit-reached")
+          }
+          const advanced = yield* tx.advanceGeneration(command.sandbox)
+          const result = yield* decode(
+            ResetResult,
+            {
+              _tag: "Committed",
+              previous: command.sandbox,
+              current: advanced,
+              requestId: command.requestId
+            },
+            "unavailable"
+          )
+          yield* tx.audit({
+            operation: "Reset",
+            reason: "generation-revocation",
+            count: 0
+          })
+          yield* tx.saveReceipt({ _tag: "Reset", command, result })
+          return result
+        })
+      )
+      .pipe(
+        Effect.catchCause((cause) =>
+          recoverMutation(cause, {
+            _tag: "OutcomeUnknown" as const,
+            previous: command.sandbox,
+            requestId: command.requestId
+          })
+        )
+      )
+  })
+  const lookup = (
+    operation: "Scenario" | "Reset",
+    access: SandboxAccess,
+    input: ReceiptRequest
+  ) =>
+    Effect.gen(function* () {
+      const request = yield* decode(ReceiptRequest, input)
+      if (request.sandbox.sandboxId !== access.sandbox.ref.sandboxId) {
+        return yield* fail("not-found")
+      }
+      if (request.sandbox.generation > access.sandbox.ref.generation) {
+        return yield* fail("stale-generation")
+      }
+      const raw = yield* transactions
+        .lookup(access, request, operation)
+        .pipe(Effect.catchCause((cause) => Effect.failCause(sanitizeCause(cause))))
+      if (raw === null) {
+        return null
+      }
+      return yield* validateReceipt(raw, request, operation)
+    })
+  return CommandPersistence.of({
+    run,
+    reset,
+    scenarioReceipt: Effect.fn("Commands.scenarioReceipt")(function* (access, request) {
+      const receipt = yield* lookup("Scenario", access, request)
+      if (receipt === null) {
+        return {
+          _tag: "OutcomeUnknown",
+          sandbox: request.sandbox,
+          requestId: request.requestId
+        }
+      }
+      if (receipt._tag !== "Scenario") {
+        return yield* fail("unavailable")
+      }
+      return receipt.result
+    }),
+    resetReceipt: Effect.fn("Commands.resetReceipt")(function* (access, request) {
+      const receipt = yield* lookup("Reset", access, request)
+      if (receipt === null) {
+        return {
+          _tag: "OutcomeUnknown",
+          previous: request.sandbox,
+          requestId: request.requestId
+        }
+      }
+      if (receipt._tag !== "Reset") {
+        return yield* fail("unavailable")
+      }
+      return receipt.result
+    })
+  })
+})
+
+// No default CommandTransactions/JobEnqueue/key Layer is installed here.
+export const layerNoDeps = Layer.effect(CommandPersistence, make)
diff --git a/apps/playground-worker/src/persistence/commands/Transactions.ts b/apps/playground-worker/src/persistence/commands/Transactions.ts
new file mode 100644
index 0000000..1d73723
--- /dev/null
+++ b/apps/playground-worker/src/persistence/commands/Transactions.ts
@@ -0,0 +1,89 @@
+import { Context, Effect, Layer, Schema } from "effect"
+import type { JobId } from "effect-jobs/JobId"
+import type { SandboxAccess, SandboxRef } from "@effect-jobs/playground-contracts/Sandbox"
+import {
+  ResetCommand,
+  ResetResult,
+  ScenarioCommand,
+  ScenarioResult
+} from "@effect-jobs/playground-contracts/Scenarios"
+import type { ReceiptRequest } from "@effect-jobs/playground-contracts/Scenarios"
+import { PlaygroundError, Scenarios } from "@effect-jobs/playground-contracts/Services"
+import type { PlannedJob } from "../../scenarios/Plan.js"
+
+export const StoredReceipt = Schema.Union([
+  Schema.TaggedStruct("Scenario", {
+    command: ScenarioCommand,
+    result: ScenarioResult.members[0]
+  }),
+  Schema.TaggedStruct("Reset", { command: ResetCommand, result: ResetResult })
+])
+export type StoredReceipt = typeof StoredReceipt.Type
+
+export class CommandTransactionFailure extends Schema.TaggedError<CommandTransactionFailure>()(
+  "CommandTransactionFailure",
+  { commitKnowledge: Schema.Literals(["NotCommitted", "Unknown"]) }
+) {}
+export type StoreError = PlaygroundError | CommandTransactionFailure
+
+// Application-only port proposal. No structural SQL handle or library lifecycle authority.
+// The owner locks the sandbox BEFORE invoking body, using DB time; owns the
+// exact ambient producer connection, bounded COMMIT/rollback/release, and never retries.
+export interface CommandTransaction {
+  // Proven first submission, never inferred from absence of a result receipt.
+  readonly admission: "Fresh" | "Unresolved"
+  readonly current: SandboxRef
+  readonly dbNow: number
+  readonly expiresAt: number
+  readonly receipt: (
+    request: ReceiptRequest,
+    operation: "Scenario" | "Reset"
+  ) => Effect.Effect<StoredReceipt | null, StoreError>
+  readonly reserve: (count: number) => Effect.Effect<void, StoreError>
+  readonly associate: (jobId: JobId, job: PlannedJob) => Effect.Effect<void, StoreError>
+  readonly advanceGeneration: (
+    expected: SandboxRef
+  ) => Effect.Effect<SandboxRef, StoreError>
+  readonly saveReceipt: (receipt: StoredReceipt) => Effect.Effect<void, StoreError>
+  readonly audit: (entry: {
+    readonly operation: "Scenario" | "Reset"
+    readonly reason: "synthetic-scenario" | "generation-revocation"
+    readonly count: number
+  }) => Effect.Effect<void, StoreError>
+}
+export class CommandTransactions extends Context.Service<
+  CommandTransactions,
+  {
+    readonly owned: <A, E, R>(
+      access: SandboxAccess,
+      request: ReceiptRequest,
+      operation: "Scenario" | "Reset",
+      body: (transaction: CommandTransaction) => Effect.Effect<A, E, R>
+    ) => Effect.Effect<A, E | StoreError, R>
+    // Read-only, DB-time expiry checked, scoped to the authenticated sandbox.
+    // Old generations may be read for exact reset reconciliation, never written.
+    readonly lookup: (
+      access: SandboxAccess,
+      request: ReceiptRequest,
+      operation: "Scenario" | "Reset"
+    ) => Effect.Effect<StoredReceipt | null, StoreError>
+  }
+>()("playground/CommandTransactions") {}
+
+export class CommandPersistence extends Context.Service<
+  CommandPersistence,
+  typeof Scenarios.Service
+>()("playground/CommandPersistence") {}
+
+// Explicit default while authority/transaction persistence remains unqualified.
+const unavailable = () =>
+  Effect.fail(new PlaygroundError({ code: "capability-unavailable" }))
+export const unavailableLayer = Layer.succeed(
+  CommandPersistence,
+  CommandPersistence.of({
+    run: unavailable,
+    reset: unavailable,
+    scenarioReceipt: unavailable,
+    resetReceipt: unavailable
+  })
+)
diff --git a/apps/playground-worker/src/persistence/read/Queries.ts b/apps/playground-worker/src/persistence/read/Queries.ts
new file mode 100644
index 0000000..3b187ff
--- /dev/null
+++ b/apps/playground-worker/src/persistence/read/Queries.ts
@@ -0,0 +1,79 @@
+import type { ListJobs, JobDetailRequest } from "@effect-jobs/playground-contracts/Jobs"
+import type { SandboxRef } from "@effect-jobs/playground-contracts/Sandbox"
+
+// App-owned read model, not a public library read/admin API. Identifiers are
+// configuration only; all request values use PostgreSQL parameters.
+export interface Mapping {
+  readonly schema: string
+  readonly jobsTable: string
+  readonly sandboxesTable: string
+  readonly associationsTable: string
+}
+export interface Query {
+  readonly text: string
+  readonly values: ReadonlyArray<unknown>
+}
+const identifier = (name: string) => {
+  if (!/^[a-z_][a-z0-9_]{0,62}$/u.test(name)) {
+    throw new Error("Invalid read mapping identifier")
+  }
+  return `"${name}"`
+}
+const summary = `jsonb_build_object(
+  'jobId',j.id,'catalog',jsonb_build_object('queue',j.queue,'kind',j.kind,'version',j.version),
+  'state',j.state,'availableAt',j.available_at,'updatedAt',j.updated_at,
+  'completedAt',j.completed_at,'attemptsMade',j.attempts_made,
+  'stalledCount',j.stalled_count,'lifecycleVersion',j.lifecycle_version,
+  'lastFailureCode',j.last_failure_code)`
+
+export const make = (mapping: Mapping) => {
+  const schema = identifier(mapping.schema)
+  const jobs = `${schema}.${identifier(mapping.jobsTable)}`
+  const sandboxes = `${schema}.${identifier(mapping.sandboxesTable)}`
+  const associations = `${schema}.${identifier(mapping.associationsTable)}`
+  if (
+    new Set([mapping.jobsTable, mapping.sandboxesTable, mapping.associationsTable])
+      .size !== 3
+  ) {
+    throw new Error("Read mapping tables must differ")
+  }
+  // DB time and authority/data share a single statement snapshot. Reset/expiry
+  // committed before statement start is visible; later commits reconcile next read.
+  const authority = `WITH authority AS MATERIALIZED (
+    SELECT CASE WHEN expires_at <= floor(extract(epoch FROM clock_timestamp())*1000)::bigint
+      THEN 'sandbox-expired' WHEN generation <> $2 THEN 'stale-generation' ELSE 'ok' END AS status
+    FROM ${sandboxes} WHERE sandbox_id=$1
+  ), status AS (
+    SELECT coalesce((SELECT status FROM authority),'sandbox-expired') AS code
+  )`
+  const scoped = `FROM ${associations} a JOIN ${jobs} j ON j.id=a.job_id
+    WHERE a.sandbox_id=$1 AND a.generation=$2 AND (SELECT code FROM status)='ok'`
+  return {
+    list: (ref: SandboxRef, request: ListJobs, after: string | null): Query => ({
+      text: `${authority}, page AS (
+        SELECT j.id, ${summary} AS item ${scoped}
+          AND ($3::text IS NULL OR j.state=$3) AND ($4::text IS NULL OR j.kind=$4)
+          AND ($5::text IS NULL OR j.id COLLATE "C" > $5 COLLATE "C")
+        ORDER BY j.id COLLATE "C" ASC LIMIT $6
+      ) SELECT (SELECT code FROM status) AS status,
+        coalesce(jsonb_agg(item ORDER BY id COLLATE "C"),'[]'::jsonb) AS items FROM page`,
+      values: [
+        ref.sandboxId,
+        ref.generation,
+        request.filters.state ?? null,
+        request.filters.kind ?? null,
+        after,
+        request.limit + 1
+      ]
+    }),
+    detail: (ref: SandboxRef, request: JobDetailRequest): Query => ({
+      text: `${authority} SELECT (SELECT code FROM status) AS status, (
+        SELECT jsonb_build_object('sandbox',jsonb_build_object('sandboxId',$1::text,'generation',$2::bigint),
+          'job',${summary},'producer',jsonb_build_object('operation',j.operation,
+          'operationId',j.operation_id,'slot',j.slot),'policy',j.policy,'relations',a.relations)
+        ${scoped} AND j.id=$3
+      ) AS detail`,
+      values: [ref.sandboxId, ref.generation, request.jobId]
+    })
+  }
+}
diff --git a/apps/playground-worker/src/persistence/read/SchemaProposal.ts b/apps/playground-worker/src/persistence/read/SchemaProposal.ts
