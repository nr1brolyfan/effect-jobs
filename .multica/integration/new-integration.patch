+import { SandboxView } from "@effect-jobs/playground-contracts/Sandbox"
+import { ScenarioResult, ResetResult } from "@effect-jobs/playground-contracts/Scenarios"
+import { PlaygroundError, PublicError } from "@effect-jobs/playground-contracts/Services"
+import type { Client } from "../features/jobs/Adapter.js"
+
+const csrf = () =>
+  document.cookie
+    .split(";")
+    .map((part) => part.trim())
+    .find((part) => part.startsWith("__Host-playground-csrf="))
+    ?.split("=")[1] ?? ""
+const request = <S extends Schema.Top & { readonly DecodingServices: never }>(
+  path: string,
+  schema: S,
+  method = "GET",
+  body?: unknown
+) =>
+  Effect.tryPromise({
+    try: (signal) =>
+      fetch(path, {
+        method,
+        credentials: "same-origin",
+        signal,
+        headers:
+          method === "POST"
+            ? { "Content-Type": "application/json", "X-Playground-CSRF": csrf() }
+            : {},
+        ...(body === undefined ? {} : { body: JSON.stringify(body) })
+      }),
+    catch: () => new PlaygroundError({ code: "unavailable" })
+  }).pipe(
+    Effect.flatMap((response) =>
+      Effect.tryPromise({
+        try: () => response.json() as Promise<unknown>,
+        catch: () => new PlaygroundError({ code: "unavailable" })
+      }).pipe(
+        Effect.flatMap((raw) =>
+          response.ok
+            ? Schema.decodeUnknownEffect(schema)(raw, { onExcessProperty: "error" }).pipe(
+                Effect.mapError(() => new PlaygroundError({ code: "unavailable" }))
+              )
+            : Schema.decodeUnknownEffect(PublicError)(raw).pipe(
+                Effect.mapError(() => new PlaygroundError({ code: "unavailable" })),
+                Effect.flatMap((error) => Effect.fail(new PlaygroundError(error)))
+              )
+        )
+      )
+    ),
+    Effect.timeoutOrElse({
+      duration: "8 seconds",
+      orElse: () => Effect.fail(new PlaygroundError({ code: "unavailable" }))
+    })
+  )
+const params = (
+  input: { sandbox: { sandboxId: string; generation: number } },
+  extra: Record<string, string | undefined> = {}
+) =>
+  new URLSearchParams({
+    sandboxId: input.sandbox.sandboxId,
+    generation: String(input.sandbox.generation),
+    ...Object.fromEntries(
+      Object.entries(extra).filter(
+        (entry): entry is [string, string] => entry[1] !== undefined
+      )
+    )
+  }).toString()
+export const issue = () => request("/api/sandbox/issue", SandboxView, "POST")
+export const client: Client = {
+  source: "workerd",
+  describe: () => request("/api/sandbox", SandboxView, "POST"),
+  list: (input) =>
+    request(
+      `/api/jobs?${params(input, { state: input.filters.state, kind: input.filters.kind, limit: String(input.limit), cursor: input.cursor })}`,
+      JobPage
+    ),
+  detail: (input) =>
+    request(`/api/jobs/detail?${params(input, { jobId: input.jobId })}`, JobDetail),
+  run: (input) => request("/api/scenarios", ScenarioResult, "POST", input),
+  reset: (input) => request("/api/sandbox/reset", ResetResult, "POST", input),
+  scenarioReceipt: (input) =>
+    request("/api/scenarios/receipt", ScenarioResult, "POST", input),
+  resetReceipt: (input) =>
+    request("/api/sandbox/reset/receipt", ResetResult, "POST", input)
+}
diff --git a/apps/website/src/server/HttpApplication.ts b/apps/website/src/server/HttpApplication.ts
new file mode 100644
index 0000000..98bdc30
--- /dev/null
+++ b/apps/website/src/server/HttpApplication.ts
@@ -0,0 +1,184 @@
+import { Cause, Effect, Redacted } from "effect"
+import {
+  PlaygroundError,
+  JobsRead,
+  Scenarios
+} from "@effect-jobs/playground-contracts/Services"
+import { routes } from "./Routes.js"
+import { Application } from "./Services.js"
+import * as Commands from "./commands/HttpCommands.js"
+import * as Read from "./read/HttpRead.js"
+
+export const credentialCookie = "__Host-playground"
+export const csrfCookie = "__Host-playground-csrf"
+export const cookie = (request: Request, name: string) => {
+  const values = (request.headers.get("Cookie") ?? "")
+    .split(";")
+    .map((part) => part.trim())
+    .filter((part) => part.startsWith(name + "="))
+  return values.length === 1 ? values[0]!.slice(name.length + 1) : undefined
+}
+const reject = (code: PlaygroundError["code"]) => new PlaygroundError({ code })
+export const authenticate = (request: Request) =>
+  Effect.gen(function* () {
+    const app = yield* Application
+    const credential = cookie(request, credentialCookie)
+    if (!credential) {
+      return yield* reject("not-found")
+    }
+    return yield* app.authenticate(Redacted.make(credential))
+  })
+// Origin + Fetch metadata + double-submit token. No credential in JS or DTOs.
+export const csrf = (request: Request, origin: string, issue = false) => {
+  const token = cookie(request, csrfCookie)
+  return (
+    request.method === "POST" &&
+    new URL(request.url).origin === origin &&
+    request.headers.get("Origin") === origin &&
+    (!request.headers.has("Sec-Fetch-Site") ||
+      request.headers.get("Sec-Fetch-Site") === "same-origin") &&
+    request.headers.get("Content-Type")?.split(";")[0]?.trim() === "application/json" &&
+    (issue ||
+      (token !== undefined &&
+        /^[0-9a-f]{64}$/.test(token) &&
+        token === request.headers.get("X-Playground-CSRF")))
+  )
+}
+export const response = (value: unknown, status = 200) =>
+  Response.json(value, {
+    status,
+    headers: { "Cache-Control": "no-store", "X-Content-Type-Options": "nosniff" }
+  })
+export const handle = (
+  request: Request,
+  origin: string,
+  admit: (key: string) => boolean
+) =>
+  Effect.gen(function* () {
+    if (request.url.length > 4096 || new URL(request.url).origin !== origin) {
+      return yield* reject("invalid-request")
+    }
+    const path = new URL(request.url).pathname
+    const app = yield* Application
+    if (path === routes.sandboxIssue) {
+      if (
+        !csrf(request, origin, true) ||
+        new URL(request.url).search ||
+        cookie(request, credentialCookie) !== undefined
+      ) {
+        return yield* reject("invalid-request")
+      }
+      if (!admit("issue")) {
+        return yield* reject("limit-reached")
+      }
+      // Issuance accepts no request body; prevent an unbounded stream from reaching PG.
+      yield* requireEmptyBody(request)
+      const issued = yield* app.issue()
+      const token = yield* Effect.sync(() =>
+        Array.from(crypto.getRandomValues(new Uint8Array(32)), (byte) =>
+          byte.toString(16).padStart(2, "0")
+        ).join("")
+      )
+      const out = response(issued.sandbox)
+      out.headers.append(
+        "Set-Cookie",
+        `${credentialCookie}=${Redacted.value(issued.credential)}; Path=/; Secure; HttpOnly; SameSite=Strict`
+      )
+      out.headers.append(
+        "Set-Cookie",
+        `${csrfCookie}=${token}; Path=/; Secure; SameSite=Strict`
+      )
+      return out
+    }
+    const access = yield* authenticate(request)
+    if (!admit(access.sandbox.ref.sandboxId)) {
+      return yield* reject("limit-reached")
+    }
+    if (path === routes.sandbox) {
+      if (!csrf(request, origin) || new URL(request.url).search) {
+        return yield* reject("invalid-request")
+      }
+      yield* requireEmptyBody(request)
+      return response(yield* app.describe(access))
+    }
+    if (path === routes.jobs || path === routes.jobDetail) {
+      return yield* Read.handle(
+        access,
+        request,
+        path.endsWith("detail") ? "detail" : "list"
+      ).pipe(Effect.provideService(JobsRead, app))
+    }
+    const operations: Record<string, Commands.Operation> = {
+      [routes.scenarios]: "run",
+      [routes.scenarioReceipt]: "scenarioReceipt",
+      [routes.reset]: "reset",
+      [routes.resetReceipt]: "resetReceipt"
+    }
+    const operation = operations[path]
+    if (!operation) {
+      return response({ code: "not-found" }, 404)
+    }
+    if (!csrf(request, origin)) {
+      return yield* reject("invalid-request")
+    }
+    return yield* Commands.handle(access, request, operation, origin).pipe(
+      Effect.provideService(Scenarios, app)
+    )
+  }).pipe(
+    Effect.catchCause((cause) => {
+      if (Cause.hasInterrupts(cause)) {
+        return Effect.failCause(cause)
+      }
+      const reason = cause.reasons.length === 1 ? cause.reasons[0] : undefined
+      const code =
+        reason && Cause.isFailReason(reason) && reason.error instanceof PlaygroundError
+          ? reason.error.code
+          : "unavailable"
+      const status = {
+        "invalid-request": 400,
+        "not-found": 404,
+        "sandbox-expired": 401,
+        "stale-generation": 409,
+        "limit-reached": 429,
+        "capability-unavailable": 501,
+        unavailable: 503
+      }[code]
+      return Effect.succeed(response({ code }, status))
+    })
+  )
+
+// workerd exposes a stream for an empty POST. Bound reading and cancellation separately.
+const requireEmptyBody = (request: Request) =>
+  request.body === null
+    ? Effect.void
+    : Effect.acquireUseRelease(
+        Effect.sync(() => request.body!.getReader()),
+        (reader) =>
+          Effect.tryPromise({
+            try: () => reader.read(),
+            catch: () => reject("invalid-request")
+          }).pipe(
+            Effect.flatMap((chunk) =>
+              chunk.done ? Effect.void : Effect.fail(reject("invalid-request"))
+            ),
+            Effect.timeoutOrElse({
+              duration: "2 seconds",
+              orElse: () => Effect.fail(reject("invalid-request"))
+            })
+          ),
+        (reader) =>
+          Effect.promise(async () => {
+            let timer: ReturnType<typeof setTimeout> | undefined
+            try {
+              await Promise.race([
+                reader.cancel().catch(() => undefined),
+                new Promise<void>((done) => {
+                  timer = setTimeout(done, 100)
+                })
+              ])
+            } finally {
+              clearTimeout(timer)
+              reader.releaseLock()
+            }
+          })
+      )
