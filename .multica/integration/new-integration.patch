@@ -0,0 +1,90 @@
+// Local workerd FFI. All inputs are fresh synthetic configuration; no .env access.
+import { Miniflare, convertV4MiniflareOptions } from "miniflare"
+import { readFileSync } from "node:fs"
+import { resolve } from "node:path"
+import { createServer } from "node:net"
+const root = resolve(import.meta.dirname, "../../../..")
+export const reservePort = () =>
+  new Promise((done, reject) => {
+    const server = createServer()
+    server.once("error", reject)
+    server.listen(0, "127.0.0.1", () => {
+      const port = server.address().port
+      server.close(() => done(port))
+    })
+  })
+export const createLocal = async (cfg, { instrument = false } = {}) => {
+  const port = await reservePort()
+  const origin = `https://127.0.0.1:${port}`
+  const page =
+    '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Effect Jobs Playground</title><link rel="stylesheet" href="/Jobs.css"></head><body><main id="jobs"></main><script type="module" src="/Client.js"></script></body></html>'
+  const assets = {
+    "/": [page, "text/html"],
+    "/jobs": [page, "text/html"],
+    "/Client.js": [
+      readFileSync(`${root}/apps/website/dist/Client.js`),
+      "text/javascript"
+    ],
+    "/Jobs.css": [readFileSync(`${root}/apps/website/src/styles/Jobs.css`), "text/css"],
+    "/docs/jobs": [
+      readFileSync(`${root}/apps/website/content/docs/Jobs.html`),
+      "text/html"
+    ]
+  }
+  const mf = new Miniflare(
+    convertV4MiniflareOptions({
+      host: "127.0.0.1",
+      port,
+      https: true,
+      modules: true,
+      script: readFileSync(
+        instrument
+          ? `${root}/.multica/integration/TestWorker.js`
+          : `${root}/apps/playground-worker/dist/Worker.js`,
+        "utf8"
+      ),
+      compatibilityDate: "2026-10-01",
+      compatibilityFlags: ["nodejs_compat"],
+      durableObjects: Object.fromEntries(
+        ["Gateway", "Communications", "Media", "Commerce", "Private", "SandboxLive"].map(
+          (className, index) => [
+            ["GATEWAY", "COMMUNICATIONS", "MEDIA", "COMMERCE", "PRIVATE", "LIVE"][index],
+            {
+              className:
+                instrument && index > 0 && index < 5 ? className + "Probe" : className,
+              useSQLite: true
+            }
+          ]
+        )
+      ),
+      durableObjectsPersist: false,
+      hyperdrives: { PG: cfg.connectionString },
+      bindings: {
+        ORIGIN: origin,
+        SCHEMA: cfg.schema,
+        ENCRYPTION_KEY: cfg.encryptionKey,
+        FINGERPRINT_KEY: cfg.fingerprintKey,
+        CURSOR_KEY: cfg.cursorKey
+      },
+      serviceBindings: {
+        ASSETS: (request) => {
+          const entry = assets[new URL(request.url).pathname]
+          return entry
+            ? new Response(entry[0], {
+                headers: {
+                  "Content-Type": entry[1],
+                  "Cache-Control": "no-store",
+                  "Content-Security-Policy":
+                    "default-src 'self'; connect-src 'self'; script-src 'self'; style-src 'self'; frame-ancestors 'none'",
+                  "X-Content-Type-Options": "nosniff"
+                }
+              })
+            : new Response("Not found", { status: 404 })
+        }
+      },
+      outboundService: () => new Response("Outbound HTTP denied", { status: 403 })
+    })
+  )
+  await mf.ready
+  return { mf, origin }
+}
diff --git a/apps/playground-worker/tests/integration/Preview.mjs b/apps/playground-worker/tests/integration/Preview.mjs
new file mode 100644
index 0000000..f711188
--- /dev/null
+++ b/apps/playground-worker/tests/integration/Preview.mjs
@@ -0,0 +1,62 @@
+// User-invoked foreground preview; expiry and Ctrl-C dispose workerd and scoped DB use.
+import { readFileSync } from "node:fs"
+import { resolve } from "node:path"
+import { Pool } from "pg"
+import { createLocal } from "./Local.mjs"
+const root = resolve(import.meta.dirname, "../../../..")
+const { migrations } = await import(`${root}/.multica/integration/Migrations.mjs`)
+const cfg = JSON.parse(readFileSync(process.env.PLAYGROUND_PRIVATE_CONFIG, "utf8"))
+const pool = new Pool({
+  host: "127.0.0.1",
+  port: cfg.port,
+  user: cfg.user,
+  password: cfg.password,
+  database: cfg.database,
+  connectionTimeoutMillis: 2000,
+  statement_timeout: 5000
+})
+let mf
+let poolEnded = false
+try {
+  await pool.query(`CREATE SCHEMA "${cfg.schema}"`)
+  for (const migration of migrations(cfg.schema)) {
+    await pool.query(migration.sql)
+  }
+  await pool.end()
+  poolEnded = true
+  cfg.connectionString = `postgres://${cfg.user}:${cfg.password}@127.0.0.1:${cfg.port}/${cfg.database}`
+  const local = await createLocal(cfg)
+  mf = local.mf
+  console.log(
+    JSON.stringify({
+      url: local.origin + "/jobs",
+      expires: process.env.PLAYGROUND_DEADLINE,
+      stop: "Ctrl-C in this foreground command; wrapper removes its exact PG container",
+      tls: "local self-signed certificate",
+      hosted: "NotTested"
+    })
+  )
+  const remaining = Math.max(
+    0,
+    new Date(process.env.PLAYGROUND_DEADLINE).getTime() - Date.now() - 10000
+  )
+  await new Promise((done) => {
+    const timer = setTimeout(done, remaining)
+    const stop = () => {
+      clearTimeout(timer)
+      done()
+    }
+    process.once("SIGINT", stop)
+    process.once("SIGTERM", stop)
+  })
+} catch (error) {
+  console.log(JSON.stringify({ status: "FAIL", failureClass: error.constructor.name }))
+  process.exitCode = 1
+} finally {
+  if (mf) {
+    await mf.dispose()
+  }
+  if (!poolEnded) {
+    await pool.end()
+  }
+}
