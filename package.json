  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "specs/architecture-decisions.md",
    "specs/core-contract.md",
    "specs/drizzle-compatibility.md",
    "specs/release-qualification.md",
    "specs/api-refinements.md",
    "specs/operator-contract.md",
    "specs/postgresql-jobs.md",
    "specs/retry-policy.md",
    "docs/observability.md",
    "docs/observability-checklist.md"
  ],
  "scripts": {
    "toolchain:setup": "effect-tsgo patch --typescript --oxlint",
    "workspace:prepare": "bun run build && bun install --frozen-lockfile --ignore-scripts --force && bun run toolchain:setup && bun run --filter @effect-jobs/playground-contracts build",
    "check": "bun run toolchain:setup && tsc --project tsconfig.json --noEmit && tsc --project tsconfig.build.json --noEmit",
    "build": "bun run toolchain:setup && tsc --project tsconfig.build.json",
    "lint": "bun run toolchain:setup && oxlint --deny-warnings src tests",
    "format": "oxfmt --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --config .oxfmtrc.json --check .",
    "test": "bun run toolchain:setup && vitest run --exclude 'tests/poc/**' --exclude 'tests/benchmarks/postgresql/Support.test.mjs' && bun run test:soak",
    "check:postgresql": "tsc --project tests/postgresql/tsconfig.json --noEmit",
    "soak:postgresql": "node tests/benchmarks/postgresql/Run.mjs",
    "test:soak": "node --test tests/benchmarks/postgresql/Support.test.mjs",
    "test:postgresql:crash": "bun run build && node tests/integration/worker-crash/node_modules/vitest/vitest.mjs run --config tests/integration/worker-crash/vitest.config.mjs",
    "test:postgresql:matrix": "node tests/postgresql/Matrix.mjs",
    "test:postgresql:node": "PG_EXPECT_RUNTIME=node node node_modules/vitest/vitest.mjs run --config tests/postgresql/vitest.config.ts",
    "test:postgresql:bun": "PG_EXPECT_RUNTIME=bun bun --bun node_modules/vitest/vitest.mjs run --config tests/postgresql/vitest.config.ts",
    "qualify:postgresql:installed": "node scripts/qualify-postgresql.mjs",
    "qualify:drizzle:native": "node tests/qualification/drizzle-native/Run.mjs",
    "qualify:docs:readme": "node tests/docs/readme/Run.mjs",
    "check:docs:api": "node tests/docs/api/Qualify.mjs",
    "test:release-imports": "node --test tests/qualification/ReleaseImports.mjs",
    "verify": "bun run workspace:prepare && bun run check && bun run lint && bun run format:check && bun run playground:build && bun run test && bun run test:release-imports && bun run check:docs:api && bun run check:docs:observability",
    "release:pack": "node scripts/pack-release.mjs",
    "release:check": "node scripts/check-release.mjs",
    "qualify:release": "node scripts/qualify-release.mjs",
    "qualify:drizzle:indexes": "node tests/qualification/drizzle-indexes/Run.mjs",
    "qualify:api:installed": "node tests/qualification/api/Run.mjs",
    "playground:check": "bun run toolchain:setup && tsc -p tsconfig.playground.json",
    "playground:lint": "oxlint --deny-warnings apps packages/playground-contracts vitest.config.ts",
    "playground:test": "vitest run packages/playground-contracts/tests apps/playground-worker/tests/repairs apps/website/tests/ui/repair apps/website/tests/ui/details/Navigation.test.ts apps/playground-worker/tests/details-integration apps/website/tests/ui/RepairAtoms.test.ts",
    "playground:build": "bun run --filter @effect-jobs/playground-contracts build && bun run --filter @effect-jobs/playground build && bun run site:build && bun run --cwd apps/playground-worker build",
    "playground:qualify": "node packages/playground-contracts/qualification/Run.ts",
    "playground:preview": "python3 apps/playground-worker/tests/integration/RunOwned.py --preview",
    "playground:test:primitives": "node apps/website/tests/ui/Primitives.ts",
    "playground:test:ui": "node apps/playground/tests/ui/FormAtoms.browser.ts",
    "site:build": "bun run --cwd apps/website site:build",
    "site:check": "bun run --cwd apps/website site:check",
    "site:test": "bun run --cwd apps/website site:test",
    "site:browser": "node apps/website/tests/site/Browser.ts",
    "qualify:docs:orders": "node apps/website/tests/order-tutorial/Qualify.ts",
    "qualify:docs:examples": "node apps/website/tests/docs-reference/Qualify.ts",
    "check:docs:reference": "node apps/website/tests/docs-reference/Reference.ts --check",
    "site:routes": "node apps/website/tests/site/Routes.ts",
    "check:docs:snippets": "vitest run --project website-unit apps/website/tests/modernization/Docs.unit.ts",
    "playground:fixtures": "bun run --cwd apps/playground build:fixtures",
    "test:website": "vitest run --project website-unit --project website-browser --project website-e2e",
    "site:models": "vitest run --project workspace apps/website/tests/site-modernization/Illustrations.test.ts",
    "site:islands": "bun apps/website/tests/site-modernization/Islands.browser.ts",
    "site:landing": "node apps/website/src/components/landing/tests/Browser.mjs",
    "test:browser:install": "playwright install --with-deps chromium",
    "test:website:provider": "node apps/website/tests/modernization/ProviderLifecycle.ts",
    "check:capnp-runtime": "bun run --cwd apps/playground-worker check:capnp-runtime",
    "test:playground:native": "bun run --cwd apps/playground-worker test:native",
    "check:docs:observability": "tsc --project ai-docs/tsconfig.observability.json --noEmit",
    "qualify:observability": "node tests/qualification/observability/Run.mjs",
    "qualify:cloudflare:alchemy": "bun run --cwd examples/cloudflare-alchemy qualify"
  },
  "peerDependencies": {
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/ai-openrouter": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@effect/sql-pg": "4.1.0",
    "@effect/tsgo": "0.48.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.20.0",
    "axe-core": "4.11.0",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "4.1.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "pg": "8.23.0",
    "traits": "0.5.9",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "playwright": "1.56.1",
    "vite": "8.3.4",
    "rolldown": "1.2.13",
    "ws": "8.22.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nr1brolyfan/effect-jobs.git"
  },
  "homepage": "https://github.com/nr1brolyfan/effect-jobs#readme",
  "bugs": {
    "url": "https://github.com/nr1brolyfan/effect-jobs/issues"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "tag": "alpha"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "vite": "8.3.4",
    "alchemy": "2.0.0-beta.85",
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.85",
    "@alchemy.run/sql": "2.0.0-beta.85",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/platform-node-shared": "4.1.0",
    "@effect/sql-d1": "4.1.0",
    "@effect/sql-pg": "4.1.0"
  }
}
