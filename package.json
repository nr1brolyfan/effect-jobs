{
  "name": "effect-jobs",
  "version": "0.1.0-alpha.2",
  "private": false,
  "description": "Effect-native durable, transaction-bound background jobs.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.2",
  "exports": {
    "./JobSchedule": {
      "types": "./dist/JobSchedule.d.ts",
      "import": "./dist/JobSchedule.js"
    },
    "./JobStorage": {
      "types": "./dist/JobStorage.d.ts",
      "import": "./dist/JobStorage.js"
    },
    "./JobGroup": {
      "types": "./dist/JobGroup.d.ts",
      "import": "./dist/JobGroup.js"
    },
    "./PostgreSqlJobs": {
      "types": "./dist/postgresql/PostgreSqlJobs.d.ts",
      "import": "./dist/postgresql/PostgreSqlJobs.js"
    },
    "./PostgreSqlTransaction": {
      "types": "./dist/postgresql/PostgreSqlTransaction.d.ts",
      "import": "./dist/postgresql/PostgreSqlTransaction.js"
    },
    "./PostgreSqlSchema": {
      "types": "./dist/postgresql/PostgreSqlSchema.d.ts",
      "import": "./dist/postgresql/PostgreSqlSchema.js"
    },
    "./PostgreSqlDrizzleSchema": {
      "types": "./dist/postgresql/PostgreSqlDrizzleSchema.d.ts",
      "import": "./dist/postgresql/PostgreSqlDrizzleSchema.js"
    },
    "./JobWorker": {
      "types": "./dist/JobWorker.d.ts",
      "import": "./dist/JobWorker.js"
    },
    "./JobPolling": {
      "types": "./dist/JobPolling.d.ts",
      "import": "./dist/JobPolling.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./JobLifecycle": {
      "types": "./dist/JobLifecycle.d.ts",
      "import": "./dist/JobLifecycle.js"
    },
    "./JobStore": {
      "types": "./dist/JobStore.d.ts",
      "import": "./dist/JobStore.js"
    },
    "./Job": {
      "types": "./dist/Job.d.ts",
      "import": "./dist/Job.js"
    },
    "./JobQueue": {
      "types": "./dist/JobQueue.d.ts",
      "import": "./dist/JobQueue.js"
    },
    "./JobProducer": {
      "types": "./dist/JobProducer.d.ts",
      "import": "./dist/JobProducer.js"
    },
    "./JobPayload": {
      "types": "./dist/JobPayload.d.ts",
      "import": "./dist/JobPayload.js"
    },
    "./JobPayloadCodec": {
      "types": "./dist/JobPayloadCodec.d.ts",
      "import": "./dist/JobPayloadCodec.js"
    },
    "./JobId": {
      "types": "./dist/JobId.d.ts",
      "import": "./dist/JobId.js"
    },
    "./JobIdentity": {
      "types": "./dist/JobIdentity.d.ts",
      "import": "./dist/JobIdentity.js"
    },
    "./JobPolicy": {
      "types": "./dist/JobPolicy.d.ts",
      "import": "./dist/JobPolicy.js"
    },
    "./JobRetryPolicy": {
      "types": "./dist/JobRetryPolicy.d.ts",
      "import": "./dist/JobRetryPolicy.js"
    },
    "./JobFailure": {
      "types": "./dist/JobFailure.d.ts",
      "import": "./dist/JobFailure.js"
    },
    "./JobContract": {
      "types": "./dist/JobContract.d.ts",
      "import": "./dist/JobContract.js"
    },
    "./JobTransaction": {
      "types": "./dist/JobTransaction.d.ts",
      "import": "./dist/JobTransaction.js"
    },
    "./FailureCode": {
      "types": "./dist/FailureCode.d.ts",
      "import": "./dist/FailureCode.js"
    },
    "./JobEnqueue": {
      "types": "./dist/JobEnqueue.d.ts",
      "import": "./dist/JobEnqueue.js"
    },
    "./PostgreSqlNative": {
      "types": "./dist/postgresql/PostgreSqlNative.d.ts",
      "import": "./dist/postgresql/PostgreSqlNative.js"
    },
    "./JobOperators": {
      "types": "./dist/JobOperators.d.ts",
      "import": "./dist/JobOperators.js"
    },
    "./JobApi": {
      "types": "./dist/JobApi.d.ts",
      "import": "./dist/JobApi.js"
    },
    "./JobApiBuilder": {
      "types": "./dist/JobApiBuilder.d.ts",
      "import": "./dist/JobApiBuilder.js"
    }
