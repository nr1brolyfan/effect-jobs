---
import { Code } from "astro:components"
import { transaction, rollback, shared, handler, execution } from "../components/landing/Content.js"
import Postgres from "../components/landing/Postgres.astro"
import "../components/landing/Walkthrough.css"
import "../components/landing/Rows.css"

// A prerender chunk keeps the real extraction recipient out of the client-only
// controls bundle. The unchanged hosting integration links it on every page.
const { default: ScenePlayback } = await import("../components/landing/Playback.astro")
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Background jobs for Effect. Define the work, enqueue in your application's PostgreSQL transaction, and run an explicit worker." />
    <meta name="theme-color" content="#171719" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={new URL("/", Astro.site)} />
    <title>effect-jobs — Background jobs for Effect</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="effect-jobs home"><span class="brand-mark" aria-hidden="true">e<span>j</span></span>effect-jobs</a>
      <nav aria-label="Main navigation">
        <a href="/docs">Docs</a>
        <a href="https://github.com/nr1brolyfan/effect-jobs">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="main" class="wrap" data-result="saved" data-outcome="commit">
      <section class="intro" aria-labelledby="page-title">
        <div>
          <h1 id="page-title">Background jobs<br />for <em>Effect.</em></h1>
          <p class="intro-copy">Save the work in PostgreSQL.<br />Run it outside the request.</p>
          <div class="actions">
            <a class="primary" href="/docs/start/tutorial">Follow the tutorial <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/docs/start/installation">Installation <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <section class="scene transaction" data-phase="3" aria-labelledby="transaction-title" id="transaction">
        <div class="scene-heading"><h2 id="transaction-title">Stage separately. Commit together.</h2></div>
        <div class="scene-pair">
          <div class="code-panel">
            <div class="file-label">Application / API · place the order</div>
            <div class="transaction-code commit-code"><Code code={transaction} lang="ts" theme="github-dark" /></div>
            <div class="transaction-code rollback-code"><Code code={rollback} lang="ts" theme="github-dark" /></div>
          </div>
          <figure class="transaction-compare" aria-label="Selected outcome of the application transaction">
            <figcaption><strong>One transaction</strong><span data-at="0">BEGIN · empty</span><span data-at="1">Insert order</span><span data-at="2">Enqueue confirmation</span><span data-at="3">Transaction closed</span></figcaption>
            <ScenePlayback />
            <div class="branches">
              <div class="branch commit-path"><h3>COMMIT <span data-at="3">Confirmed ✓</span></h3><div class="branch-rows"><p class="empty-tx">No staged rows</p><div class="stage-order row-chip"><strong>Order</strong><code>order-041</code></div><div class="stage-job row-chip"><strong>Confirmation job</strong><code>order-041</code></div></div><p class="branch-result"><span data-at="0">0 saved</span><span data-at="1">1 staged · 0 saved</span><span data-at="2">2 staged · 0 saved</span><span data-at="3">Both rows saved</span></p></div>
              <div class="branch rollback-path"><h3>ROLLBACK <span data-at="3">Confirmed ✓</span></h3><div class="branch-rows"><p class="empty-tx">No staged rows</p><div class="stage-order row-chip"><strong>Order</strong><code>order-041</code></div><div class="stage-job row-chip"><strong>Confirmation job</strong><code>order-041</code></div><p class="rolled-back">No rows saved</p></div><p class="branch-result"><span data-at="0">0 saved</span><span data-at="1">1 staged · 0 saved</span><span data-at="2">2 staged · 0 saved</span><span data-at="3">Neither row saved</span></p></div>
            </div>
            <div class="transaction-status"><span data-at="0">The transaction is open. Nothing has been written.</span><span data-at="1">Only the order is staged inside the transaction.</span><span data-at="2">The job is staged too. Neither row is visible outside.</span><span data-at="3"><span class="commit-only">Saved to the database. The worker can now process the job.</span><span class="rollback-only">Rollback confirmed. Neither row was saved. No job to process.</span></span></div>
          </figure>
        </div>
        <p class="transaction-note"><span class="commit-only">Success commits both rows.</span><span class="rollback-only">The application rejects after enqueue; confirmed rollback saves neither row.</span> A lost COMMIT response remains unknown.</p>
        <div id="transaction-stages"></div>
      </section>

      <section class="scene rows-intro" aria-labelledby="rows-title" id="rows">
        <div class="scene-heading"><h2 id="rows-title">Inspect the saved rows.</h2></div>
        <figure class="database overview" aria-label="Database after COMMIT, logical Orders and Jobs projections">
          <figcaption><strong>Database <span class="saved-only">After COMMIT</span><span class="pending-only">Transaction open</span><span class="rolled-back-only">After ROLLBACK</span></strong><Postgres /></figcaption>
          <div class="row-pair">
            <table><caption>Orders</caption><thead><tr><th scope="col">orderId</th><th scope="col">sku</th><th scope="col">quantity</th></tr></thead><tbody><tr><td class="relation-key">order-041</td><td>book</td><td>1</td></tr></tbody></table>
            <table><caption>Jobs</caption><thead><tr><th scope="col">id</th><th scope="col">queue</th><th scope="col">payload.orderId</th></tr></thead><tbody><tr><td>job-7f2</td><td>orders</td><td class="relation-key">order-041</td></tr></tbody></table>
          </div>
          <p class="result-empty"><span class="pending-only">No saved rows yet.</span><span class="rolled-back-only">No order. No confirmation job.</span></p>
          <p class="projection-note">Logical projections; Jobs joins metadata with the separately stored <code>job_payloads</code>. The shared <code>orderId</code> connects the work to the order.</p>
        </figure>
      </section>

      <section class="scene handler" data-phase="4" aria-labelledby="handler-title" id="handler">
        <div class="scene-heading"><h2 id="handler-title"><span class="saved-only">Now let the worker process it.</span><span class="pending-only">Only committed jobs can run.</span><span class="rolled-back-only">No committed job to process.</span></h2></div>
        <div class="scene-pair">
          <div class="code-stack">
            <div class="code-panel registration-code"><div class="file-label">Worker · register the handler</div><Code code={handler} lang="ts" theme="github-dark" /></div>
            <div class="code-panel worker-code"><div class="file-label">Worker · bind the queue, then explicitly drain</div><Code code={execution} lang="ts" theme="github-dark" /></div>
          </div>
          <figure class="outcome worker-outcome" aria-label="Worker claims a copy of the stored job row, runs its handler, then calls the email adapter">
            <div class="worker-flow">
              <div class="flow-database"><h3>Database <Postgres /></h3><div class="job-column-labels"><span>jobId</span><span>orderId</span></div><div class="job-row stored-job"><code>job-7f2</code><code>order-041</code></div><p class="storage-state"><span data-at="0">Saved</span><span data-at="1">Claimed · still stored</span><span data-at="2">Claimed · still stored</span><span data-at="3">Claimed · still stored</span><span data-at="4">Still stored</span><span class="blocked-only">No saved job</span></p></div>
              <div class="flow-arrow claim-arrow">↓ Claim + read</div>
              <div class="worker-box"><h3>Worker <span class="worker-state"><span data-at="0">Started</span><span data-at="1">Claiming</span><span data-at="2">Row received</span><span data-at="3">Executing</span><span data-at="4">Handler finished</span></span></h3><div class="job-column-labels"><span>jobId</span><span>orderId</span></div><div class="job-row received-job"><code>job-7f2</code><code>order-041</code></div><div class="handler-operation"><strong>Handler</strong><span class="handler-state"><span data-at="0">Waiting for a job</span><span data-at="1">Waiting for the row</span><span data-at="2">Ready to run</span><span data-at="3">Confirming order-041</span><span data-at="4">Email adapter called ✓</span></span></div><p class="blocked-only">No committed job to process.</p></div>
              <div class="flow-arrow adapter-arrow">↓ emails.send(…)</div>
              <div class="adapter-box"><strong>Email adapter</strong><span class="adapter-key">deliveryKey: <code>job-7f2</code></span></div>
              <div class="job-row travel-row" aria-hidden="true"><code>job-7f2</code><code>order-041</code></div>
            </div>
          </figure>
        </div>
        <div id="worker-controls"></div>
      </section>

      <section class="scene shared-reference" aria-labelledby="shared-title" id="shared">
        <div class="scene-heading"><h2 id="shared-title">Shared definitions.</h2></div>
        <div class="scene-pair">
          <div class="code-panel"><div class="file-label">shared/jobs/orders.ts</div><Code code={shared} lang="ts" theme="github-dark" /></div>
          <div class="shared-roles"><p>One contract, used on both sides.</p><div><h3>Application / API</h3><code>PlaceOrder.enqueue(…)</code><p>The slot selects the confirmation job and its orders queue.</p></div><div><h3>Worker</h3><code>JobWorker.layer(OrdersJobApi, …)</code><p>The same catalog installs the handler; the same queue selects its work.</p></div><p class="reference-note">Definitions configure the route. Only the transaction writes rows; only an explicit drain or poll executes jobs.</p></div>
        </div>
      </section>

      <section class="next" aria-labelledby="next-title">
        <div><h2 id="next-title">Build the complete example.</h2><p class="release-note">Illustrative excerpts of the unreleased API; published alpha.2 differs. The <a href="/docs/start/tutorial">tutorial</a> covers producer setup, worker wiring and error handling. External delivery needs idempotency or reconciliation. See <a href="/docs/start/installation">installation</a>.</p></div>
        <a class="primary" href="/docs/start/tutorial">Open getting started <span aria-hidden="true">→</span></a>
      </section>
    </main>
    <footer class="wrap"><a class="wordmark" href="/">effect-jobs</a><a href="/docs/playground">Local playground guide <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
