---
interface Props { name: "api" | "database" | "worker" | "email" | "invoice" | "order" }
const { name } = Astro.props
---
<svg class="jv-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "api" && <><path d="m8 5-6 7 6 7m8-14 6 7-6 7M14 3l-4 18" /></>}
  {name === "database" && <><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0"/></>}
  {name === "worker" && <><rect x="3" y="6" width="18" height="15" rx="5"/><path d="M12 2v4M8 16h8"/><circle cx="8" cy="11" r="1"/><circle cx="16" cy="11" r="1"/></>}
  {name === "email" && <><rect x="2" y="4" width="20" height="16" rx="3"/><path d="m3 6 9 7 9-7"/></>}
  {name === "invoice" && <><path d="M5 2h10l4 4v16H5zM15 2v5h4M8 11h8M8 15h8M8 19h4"/></>}
  {name === "order" && <><path d="M5 3h14v19l-3-2-4 2-4-2-3 2zM8 8h8M8 12h8M8 16h4"/></>}
</svg>
