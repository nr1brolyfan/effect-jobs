{
  "name": "order-tutorial",
  "private": true,
  "type": "module",
  "imports": {
    "#orders/*": {
      "types": "./packages/orders/src/*.ts",
      "development": "./packages/orders/src/*.ts",
      "default": "./dist/packages/orders/src/*.js"
    },
    "#database/*": {
      "types": "./packages/database/src/*.ts",
      "development": "./packages/database/src/*.ts",
      "default": "./dist/packages/database/src/*.js"
    },
    "#api/orders/*": {
      "types": "./apps/api/src/orders/*.ts",
      "development": "./apps/api/src/orders/*.ts",
      "default": "./dist/apps/api/src/orders/*.js"
    },
    "#worker/orders/*": {
      "types": "./apps/worker/src/orders/*.ts",
      "development": "./apps/worker/src/orders/*.ts",
      "default": "./dist/apps/worker/src/orders/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "effect": "4.1.3",
    "@effect/sql-pg": "4.1.3",
    "pg": "8.23.0",
    "drizzle-orm": "https://raw.githubusercontent.com/nr1brolyfan/drizzle-orm/3f651f2bce7edf64f1217a1cfb6ed3d2e6e9c54b/fork-artifacts/drizzle-orm-1.0.0-rc.6-effect-jobs.1.tgz",
    "@effect/platform-node": "4.1.3",
    "@effect/platform-node-shared": "4.1.3"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.4.1"
  }
}
