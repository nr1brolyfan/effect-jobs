{
  "name": "@effect-jobs/playground-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect-jobs/playground-contracts": "workspace:*",
    "@effect/atom-react": "4.0.5",
    "@stylexjs/stylex": "0.19.1",
    "@tanstack/react-table": "8.21.3",
    "effect": "4.0.5",
    "effect-jobs": "file:../..",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "scheduler": "0.27.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "bun build.mjs && bun run site:build",
