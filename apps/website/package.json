    "site:test": "node --test tests/site/Foundation.mjs",
    "site:browser": "node tests/site/Browser.mjs",
    "site:routes": "node tests/site/Routes.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
