    "site:browser": "node tests/site/Browser.ts",
    "site:routes": "node tests/site/Routes.ts"
  },
  "devDependencies": {
    "@astrojs/react": "7.1.5",
    "@astrojs/starlight": "0.42.6",
    "@babel/core": "7.29.7",
    "@babel/plugin-syntax-typescript": "7.29.7",
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@effect/sql-pg": "4.0.5",
    "@stylexjs/babel-plugin": "0.19.1",
    "@stylexjs/unplugin": "0.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.2",
    "oxc-transform-react": "0.156.0",
    "unplugin": "2.3.11",
    "@playwright/test": "1.56.1",
    "@base-ui/react": "1.9.0",
    "effect-jobs": "file:../..",
    "@effect-jobs/playground-contracts": "workspace:*"
  }
