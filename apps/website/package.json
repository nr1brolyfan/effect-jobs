{
  "name": "@effect-jobs/website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@stylexjs/stylex": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@effect/atom-react": "4.0.5",
    "effect": "4.0.5",
    "lucide-react": "1.71.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json",
    "build": "astro build",
    "site:build": "astro build",
    "site:check": "astro sync && tsc --project tsconfig.site.json --noEmit",
