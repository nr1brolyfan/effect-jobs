{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    ".astro/types.d.ts",
    "src/content.config.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx"
  ],
  "exclude": ["dist", "node_modules"]
}
